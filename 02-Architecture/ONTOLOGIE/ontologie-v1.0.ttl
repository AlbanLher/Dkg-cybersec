@prefix : <http://example.org/cyber-ontology#> .
@prefix cve: <https://cve.mitre.org/> .
@prefix mitre: <https://attack.mitre.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# === Classes ===
:Device a owl:Class ;
    rdfs:label "Appareil" ;
    rdfs:comment "Un device physique ou virtuel (PC, routeur, serveur)." .

:Software a owl:Class ;
    rdfs:label "Logiciel" ;
    rdfs:comment "Un logiciel installé sur un device." .

:Vulnerability a owl:Class ;
    rdfs:label "Vulnérabilité" ;
    rdfs:subClassOf :Threat ;
    rdfs:comment "Une vulnérabilité (ex: CVE)." .

:Threat a owl:Class ;
    rdfs:label "Menace" ;
    rdfs:comment "Une menace générique (ex: attaque, faille)." .

:Rule a owl:Class ;
    rdfs:label "Règle de sécurité" ;
    rdfs:comment "Une règle à appliquer (ex: 'Mettre à jour OpenSSL')." .

:User a owl:Class ;
    rdfs:label "Utilisateur" ;
    rdfs:comment "Un utilisateur du système (ex: Alban, employé)." .

:Action a owl:Class ;
    rdfs:label "Action corrective" ;
    rdfs:comment "Une action à effectuer (ex: 'Redémarrer le serveur')." .

# === Propriétés ===
:hasVulnerability a owl:ObjectProperty ;
    rdfs:domain :Device ;
    rdfs:range :Vulnerability ;
    rdfs:label "a pour vulnérabilité" .

:hasSoftware a owl:ObjectProperty ;
    rdfs:domain :Device ;
    rdfs:range :Software ;
    rdfs:label "a pour logiciel" .

:appliesTo a owl:ObjectProperty ;
    rdfs:domain :Rule ;
    rdfs:range :Device ;
    rdfs:label "s'applique à" .

:requiresAction a owl:ObjectProperty ;
    rdfs:domain :Vulnerability ;
    rdfs:range :Action ;
    rdfs:label "nécessite l'action" .

:assignedTo a owl:ObjectProperty ;
    rdfs:domain :Rule ;
    rdfs:range :User ;
    rdfs:label "est assignée à" .

:hasUser a owl:ObjectProperty ;
    rdfs:domain :Device ;
    rdfs:range :User ;
    rdfs:label "est utilisé par" .

:cvssScore a owl:DatatypeProperty ;
    rdfs:domain :Vulnerability ;
    rdfs:range xsd:float ;
    rdfs:label "score CVSS" .

:version a owl:DatatypeProperty ;
    rdfs:domain :Software ;
    rdfs:range xsd:string ;
    rdfs:label "version" .

:description a owl:DatatypeProperty ;
    rdfs:domain :Rule ;
    rdfs:range xsd:string ;
    rdfs:label "description" .

# === Exemples de données ===
:MonPC a rdf:type :Device ;
    foaf:name "PC Alban" ;
    :hasSoftware :OpenSSL_1_0_2, :Apache_2_4_54 ;
    :hasUser :Alban ;
    :hasVulnerability cve:CVE-2023-1234 .

:OpenSSL_1_0_2 a rdf:type :Software ;
    foaf:name "OpenSSL" ;
    :version "1.0.2" .

:Apache_2_4_54 a rdf:type :Software ;
    foaf:name "Apache" ;
    :version "2.4.54" .

:Alban a rdf:type :User ;
    foaf:name "Alban" .

cve:CVE-2023-1234 a rdf:type :Vulnerability ;
    foaf:name "CVE-2023-1234" ;
    :cvssScore 9.8 ;
    :requiresAction :UpdateOpenSSL .

:UpdateOpenSSL a rdf:type :Action ;
    foaf:name "Mettre à jour OpenSSL" ;
    :description "Mettre à jour vers OpenSSL 3.0.8" .
