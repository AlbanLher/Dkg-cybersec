@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# === Classes Pseudo-Privées (POC uniquement) ===
# ⚠️ Ces classes sont PUBLIQUES dans le POC pour la collaboration.
#    Dans un vrai projet, elles seraient dans .private/ontologie-privee.ttl

pseudo:TestEnvironment a owl:Class ;
    rdfs:label "Environnement de test" ;
    rdfs:comment "Contexte pour les tests du POC. **À ne pas utiliser en production.**" .

pseudo:MockDevice a owl:Class ;
    rdfs:subClassOf :Device ;
    rdfs:label "Device de test" ;
    rdfs:comment "Device fictif pour le POC. Exemple : 'Test-PC-001'." .

pseudo:MockVulnerability a owl:Class ;
    rdfs:subClassOf :Vulnerability ;
    rdfs:label "Vulnérabilité de test" ;
    rdfs:comment "CVE fictive pour le POC. Exemple : 'CVE-2026-9999'." .

pseudo:MockRule a owl:Class ;
    rdfs:subClassOf :Rule ;
    rdfs:label "Règle de test" ;
    rdfs:comment "Règle fictive pour le POC." .

# === Propriétés Pseudo-Privées ===
pseudo:hasTestStatus a owl:ObjectProperty ;
    rdfs:domain pseudo:MockDevice ;
    rdfs:range pseudo:TestStatus ;
    rdfs:label "a pour statut de test" .

pseudo:TestStatus a owl:Class ;
    rdfs:label "Statut de test" .

pseudo:Passed a owl:NamedIndividual , pseudo:TestStatus ;
    rdfs:label "Test réussi" .

pseudo:Failed a owl:NamedIndividual , pseudo:TestStatus ;
    rdfs:label "Test échoué" .

# === Exemples pour le POC ===
pseudo:Test-PC-001 a pseudo:MockDevice , :Device ;
    foaf:name "Test-PC-001" ;
    :hasSoftware :OpenSSL_1_0_2 ;
    pseudo:hasTestStatus pseudo:Passed .

pseudo:CVE-2026-9999 a pseudo:MockVulnerability , :Vulnerability ;
    foaf:name "CVE-2026-9999" ;
    :cvssScore 9.9 ;
    :description "Vulnérabilité de test pour le POC." .
