# Volume EOL TLP:CLEAR — ABox Externe (frugalité : cumul conservé, ingestion par delta idempotente, offline-first)
# SOURCES: eol_source
# 🌐 eol_source — STAND-BY / HORS-LIGNE () : volume simulé depuis le fonds de recette local
# 📊 RATIOS — distant sondé : 0 octets | téléchargé : 0 | persisté en local : 1,972 | RAM : 1,972 octets
# Triplets: 40 | instances EOL ajoutées cette fois: 0
@prefix dkg: <http://dkg.cybersec.org/tbox#> .
@prefix dkg-eol: <http://dkg.cybersec.org/eol#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dkg-eol:eol-centos-7 a dkg-eol:EndOfLife ;
    dkg:componentVersion "7" ;
    dkg:eolDate "2024-06-30"^^xsd:date ;
    dkg:hasTLPMarking "TLP:CLEAR" ;
    dkg:productName "CentOS Linux" ;
    dkg:providedBy dkg-eol:eol_source ;
    dkg:sourceNote "Fin de maintenance — Project CentOS annonce EOL (fait public)" ;
    dkg:supportStatus "end-of-life" .

