@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix cyber: <http://example.org/cyber-ontology#> .

cyber:PubliqueOntology a owl:Ontology ;
    rdfs:label "Ontologie Cybersécurité Publique - Phase 0"@fr .

cyber:Device a owl:Class ; rdfs:label "Équipement Système"@fr .
cyber:Vulnerability a owl:Class ; rdfs:label "Vulnérabilité Sécurité"@fr .

cyber:hasVulnerability a owl:ObjectProperty ;
    rdfs:domain cyber:Device ;
    rdfs:range cyber:Vulnerability .
