ex:Concept___R_f_rentiels_Publics_Externe_Int_gr_s_au_Lexique_SKOS a skos:Concept ;
    skos:definition "**Glosssaire Cyber ANSSI**|ANSSI (France)|Vocabulaire officiel français de la sécurité du numérique (définitions juridiques, réglementaires et techniques).|Markdown / CSV|"@fr,
        "**NIST Computer Security Resource Center (CSRC) Glossary**|NIST (USA)|Plus grand thesaurus de termes de cybersécurité normalisés (plus de 7 000 définitions).|JSON / SKOS / CSV|"@fr ;
    skos:prefLabel "🌐 Référentiels Publics Externe Intégrés au Lexique SKOS"@fr .

cve:CVE-2023-1234 a :Vulnerability ;
    :cvssScore 9.8 ;
    :description "Vulnérabilité critique dans OpenSSL 1.0.2 permettant une exécution de code à distance." ;
    foaf:name "CVE-2023-1234" .

:Action a owl:Class ;
    rdfs:label "Action corrective" .

:Software a owl:Class ;
    rdfs:label "Logiciel" .

:Threat a owl:Class ;
    rdfs:label "Menace" .

:Device a owl:Class ;
    rdfs:label "Appareil",
        "Équipement Système"@fr ;
    rdfs:comment "Un device physique ou virtuel (PC, routeur, serveur)." .

:Vulnerability a owl:Class ;
    rdfs:label "Vulnérabilité",
        "Vulnérabilité Sécurité"@fr ;
    rdfs:subClassOf :Threat .

