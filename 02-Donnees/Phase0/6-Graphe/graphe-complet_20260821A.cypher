UNWIND [{_id:19, properties:{cyber:"http://example.org/cyber-ontology#", skos:"http://www.w3.org/2004/02/skos/core#", ns0:"http://purl.org/dc/terms/", foaf:"http://xmlns.com/foaf/0.1/"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:_NsPrefDef;
UNWIND [{uri:"https://www.misp-project.org/taxonomies/interactive-cyber-training-audience", properties:{ns0__title:"Describes the target of cyber training and education."}}, {uri:"https://www.misp-project.org/taxonomies/type", properties:{ns0__title:"Taxonomy to describe different types of intelligence gathering discipline which can be described the origin of intelligence."}}, {uri:"https://www.misp-project.org/taxonomies/event-assessment", properties:{ns0__title:"A series of assessment predicates describing the event assessment performed to make judgement(s) under a certain level of uncertainty."}}, {uri:"https://www.misp-project.org/taxonomies/ics", properties:{ns0__title:"FIRST.ORG CTI SIG - MISP Proposal for ICS/OT Threat Attribution (IOC) Project"}}, {uri:"https://www.misp-project.org/taxonomies/cycat", properties:{ns0__title:"Taxonomy used by CyCAT, the Universal Cybersecurity Resource Catalogue, to categorize the namespaces it supports and uses."}}, {uri:"https://www.misp-project.org/taxonomies/doping-substances", properties:{ns0__title:"This taxonomy aims to list doping substances"}}, {uri:"https://www.misp-project.org/taxonomies/iab-ad-product-2-0", properties:{ns0__title:"IAB Tech Lab Ad Product Taxonomy 2.0 converted from the official TSV. It establishes standardized nomenclature for describing the product or service advertised within a creative unit. Source taxonomy © IAB Tech Lab, licensed under Creative Commons Attribution 3.0."}}, {uri:"https://www.misp-project.org/taxonomies/iab-audience-1-1", properties:{ns0__title:"IAB Tech Lab Audience Taxonomy 1.1 converted from the official TSV. It provides common nomenclature for audience segment names to improve comparability across data providers. Source taxonomy © IAB Tech Lab, licensed under Creative Commons Attribution 3.0."}}, {uri:"https://www.misp-project.org/taxonomies/iep", properties:{ns0__title:"Forum of Incident Response and Security Teams (FIRST) Information Exchange Policy (IEP) framework"}}, {uri:"https://www.misp-project.org/taxonomies/vmray", properties:{ns0__title:"VMRay taxonomies to map VMRay Thread Identifier scores and artifacts."}}, {uri:"https://www.misp-project.org/taxonomies/incident-disposition", properties:{ns0__title:"How an incident is classified in its process to be resolved. The taxonomy is inspired from NASA Incident Response and Management Handbook. https://www.nasa.gov/pdf/589502main_ITS-HBK-2810.09-02%20%5bNASA%20Information%20Security%20Incident%20Management%5d.pdf#page=9"}}, {uri:"https://www.misp-project.org/taxonomies/diamond-model-for-influence-operations", properties:{ns0__title:"The diamond model for influence operations analysis is a framework that leads analysts and researchers toward a comprehensive understanding of a malign influence campaign by addressing the socio-political, technical, and psychological aspects of the campaign. The diamond model for influence operations analysis consists of 5 components: 4 corners and a core element. The 4 corners are divided into 2 axes: influencer and audience on the socio-political axis, capabilities and infrastructure on the technical axis. Narrative makes up the core of the diamond."}}, {uri:"https://www.misp-project.org/taxonomies/political-spectrum", properties:{ns0__title:"A political spectrum is a system to characterize and classify different political positions in relation to one another."}}, {uri:"https://www.misp-project.org/taxonomies/europol-event", properties:{ns0__title:"This taxonomy was designed to describe the type of events"}}, {uri:"https://www.misp-project.org/taxonomies/PAP", properties:{ns0__title:"The Permissible Actions Protocol - or short: PAP - was designed to indicate how the received information can be used."}}, {uri:"https://www.misp-project.org/taxonomies/pyoti", properties:{ns0__title:"PyOTI automated enrichment schemes for point in time classification of indicators."}}, {uri:"https://www.misp-project.org/taxonomies/gea-nz-entities", properties:{ns0__title:"Information relating to instances of entities or things."}}, {uri:"https://www.misp-project.org/taxonomies/hunt-ex", properties:{ns0__title:"High-level, human-readable classification of a hunt's approach, provenance and outcome, designed for cross-organisation search and dashboards at ISAC / sector level. Detailed structured data lives in the threat-hunt-context, threat-hunt-hypothesis, threat-hunt-query and threat-hunt-finding objects; lifecycle uses workflow:state. Vocabulary is compatible with the PEAK framework (Splunk / Cisco Talos) and TaHiTI (NVB / FI-ISAC). Pair with existing taxonomies rather than duplicating them: use tlp and PAP for sharing, admiralty-scale and estimative-language for confidence and source reliability, cti-evaluation for CTI quality, priority-level for triage, DML for detection abstraction level, kill-chain / unified-kill-chain for phase, and the mitre-attack-pattern galaxy for technique mapping."}}, {uri:"https://www.misp-project.org/taxonomies/ms-caro-malware", properties:{ns0__title:"Malware Type and Platform classification based on Microsoft's implementation of the Computer Antivirus Research Organization (CARO) Naming Scheme and Malware Terminology. Based on https://www.microsoft.com/en-us/security/portal/mmpc/shared/malwarenaming.aspx, https://www.microsoft.com/security/portal/mmpc/shared/glossary.aspx, https://www.microsoft.com/security/portal/mmpc/shared/objectivecriteria.aspx, and http://www.caro.org/definitions/index.html. Malware families are extracted from Microsoft SIRs since 2008 based on https://www.microsoft.com/security/sir/archive/default.aspx and https://www.microsoft.com/en-us/security/portal/threat/threats.aspx. Note that SIRs do NOT include all Microsoft malware families."}}, {uri:"https://www.misp-project.org/taxonomies/stix-ttp", properties:{ns0__title:"TTPs are representations of the behavior or modus operandi of cyber adversaries."}}] AS row
CREATE (n:Resource{uri: row.uri}) SET n += row.properties SET n:skos__ConceptScheme;
UNWIND [{uri:"https://www.misp-project.org/taxonomies/veris", properties:{ns0__title:"Vocabulary for Event Recording and Incident Sharing (VERIS)"}}, {uri:"https://www.misp-project.org/taxonomies/monarc-threat", properties:{ns0__title:"MONARC Threats Taxonomy"}}, {uri:"https://www.misp-project.org/taxonomies/financial", properties:{ns0__title:"Financial taxonomy to describe financial services, infrastructure and financial scope."}}, {uri:"https://www.misp-project.org/taxonomies/adversary", properties:{ns0__title:"An overview and description of the adversary infrastructure"}}, {uri:"https://www.misp-project.org/taxonomies/access-method", properties:{ns0__title:"The access method used to remotely access a system."}}, {uri:"https://www.misp-project.org/taxonomies/niso-credit", properties:{ns0__title:"NISO CRediT (Contributor Roles Taxonomy) roles for describing contributor roles and optional contribution degrees in scholarly outputs."}}, {uri:"https://www.misp-project.org/taxonomies/srbcert", properties:{ns0__title:"SRB-CERT Taxonomy - Schemes of Classification in Incident Response and Detection"}}, {uri:"https://www.misp-project.org/taxonomies/uas-additionnal-classification", properties:{ns0__title:"Additional UAV and UCAV-related tags for qualifying usage and model specifications."}}, {uri:"https://www.misp-project.org/taxonomies/ecsirt", properties:{ns0__title:"Incident Classification by the ecsirt.net version mkVI of 31 March 2015 enriched with IntelMQ taxonomy-type mapping."}}, {uri:"https://www.misp-project.org/taxonomies/CERT-XLM", properties:{ns0__title:"CERT-XLM Security Incident Classification."}}, {uri:"https://www.misp-project.org/taxonomies/dark-web", properties:{ns0__title:"Criminal motivation and content detection the dark web: A categorisation model for law enforcement. ref: Janis Dalins, Campbell Wilson, Mark Carman. Taxonomy updated by MISP Project and extended by the JRC (Joint Research Centre) of the European Commission."}}, {uri:"https://www.misp-project.org/taxonomies/trust", properties:{ns0__title:"The Indicator of Trust provides insight about data on what can be trusted and known as a good actor. Similar to a whitelist but on steroids, reusing features one would use with Indicators of Compromise, but to filter out what is known to be good."}}, {uri:"https://www.misp-project.org/taxonomies/smart-airports-threats", properties:{ns0__title:"Threat taxonomy in the scope of securing smart airports by ENISA. https://www.enisa.europa.eu/publications/securing-smart-airports"}}, {uri:"https://www.misp-project.org/taxonomies/gea-nz-motivators", properties:{ns0__title:"Information relating to authority or governance."}}, {uri:"https://www.misp-project.org/taxonomies/data-classification", properties:{ns0__title:"Data classification for data potentially at risk of exfiltration based on table 2.1 of Solving Cyber Risk book."}}, {uri:"https://www.misp-project.org/taxonomies/collaborative-intelligence", properties:{ns0__title:"Collaborative intelligence support language is a common language to support analysts to perform their analysis to get crowdsourced support when using threat intelligence sharing platform like MISP. The objective of this language is to advance collaborative analysis and to share earlier than later."}}, {uri:"https://www.misp-project.org/taxonomies/iab-content-3-0-descriptive-vectors", properties:{ns0__title:"IAB Tech Lab Content Taxonomy 3.0 Descriptive Vectors converted from the official TSV. Source taxonomy © IAB Tech Lab, licensed under Creative Commons Attribution 3.0."}}, {uri:"https://www.misp-project.org/taxonomies/binary-class", properties:{ns0__title:"Custom taxonomy for types of binary file."}}, {uri:"https://www.misp-project.org/taxonomies/acn", properties:{ns0__title:"Cyber taxonomy for Italian National Cybersecurity Agency (ACN)"}}, {uri:"https://www.misp-project.org/taxonomies/meteorstorm", properties:{ns0__title:"Multiple Environment Threat Evaluation of Resources Space Threats and Operational Risk to Missions (meteorstorm) taxonomy for modeling space, cyber, and multi-domain threats and resilience across five layers: Primary Capability Environment (PCE), Segment (SEG), Service (SVC), Asset (AST), and Analytic (AN)."}}] AS row
CREATE (n:Resource{uri: row.uri}) SET n += row.properties SET n:skos__ConceptScheme;
UNWIND [{uri:"https://www.misp-project.org/taxonomies/maec-malware-behavior", properties:{ns0__title:"Malware behaviours based on MAEC 5.0"}}, {uri:"https://www.misp-project.org/taxonomies/interactive-cyber-training-training-environment", properties:{ns0__title:"The training environment details the environment around the training, consisting of training type and scenario."}}, {uri:"https://www.misp-project.org/taxonomies/malware_classification", properties:{ns0__title:"Classification based on different categories. Based on https://www.sans.org/reading-room/whitepapers/incident/malware-101-viruses-32848"}}, {uri:"https://www.misp-project.org/taxonomies/failure-mode-in-machine-learning", properties:{ns0__title:"The purpose of this taxonomy is to jointly tabulate both the of these failure modes in a single place. Intentional failures wherein the failure is caused by an active adversary attempting to subvert the system to attain her goals – either to misclassify the result, infer private training data, or to steal the underlying algorithm. Unintentional failures wherein the failure is because an ML system produces a formally correct but completely unsafe outcome."}}, {uri:"https://www.misp-project.org/taxonomies/interactive-cyber-training-technical-setup", properties:{ns0__title:"The technical setup consists of environment structure, deployment, and orchestration."}}, {uri:"https://www.misp-project.org/taxonomies/iot", properties:{ns0__title:"Internet of Things taxonomy, based on IOT UK report https://iotuk.org.uk/wp-content/uploads/2017/01/IOT-Taxonomy-Report.pdf"}}, {uri:"https://www.misp-project.org/taxonomies/ioc", properties:{ns0__title:"An IOC classification to facilitate automation of malicious and non malicious artifacts"}}, {uri:"https://www.misp-project.org/taxonomies/interception-method", properties:{ns0__title:"The interception method used to intercept traffic."}}, {uri:"https://www.misp-project.org/taxonomies/anti-piracy", properties:{ns0__title:"Taxonomy for anti-piracy"}}, {uri:"https://www.misp-project.org/taxonomies/cryptocurrency-threat", properties:{ns0__title:"Threats targeting cryptocurrency, based on CipherTrace report."}}, {uri:"https://www.misp-project.org/taxonomies/de-vs", properties:{ns0__title:"German (DE) Government classification markings (VS)."}}, {uri:"https://www.misp-project.org/taxonomies/threats-to-dns", properties:{ns0__title:"An overview of some of the known attacks related to DNS as described by Torabi, S., Boukhtouta, A., Assi, C., & Debbabi, M. (2018) in Detecting Internet Abuse by Analyzing Passive DNS Traffic: A Survey of Implemented Systems. IEEE Communications Surveys & Tutorials, 1–1. doi:10.1109/comst.2018.2849614"}}, {uri:"https://www.misp-project.org/taxonomies/gea-nz-activities", properties:{ns0__title:"Information needed to track or monitor moments, periods or events that occur over time. This type of information is focused on occurrences that must be tracked for business reasons or represent a specific point in the evolution of ‘The Business’."}}, {uri:"https://www.misp-project.org/taxonomies/information-security-indicators", properties:{ns0__title:"A full set of operational indicators for organizations to use to benchmark their security posture."}}, {uri:"https://www.misp-project.org/taxonomies/osint", properties:{ns0__title:"Open Source Intelligence - Classification (MISP taxonomies)"}}, {uri:"https://www.misp-project.org/taxonomies/fr-classif", properties:{ns0__title:"French gov information classification system"}}, {uri:"https://www.misp-project.org/taxonomies/fpf", properties:{ns0__title:"The Future of Privacy Forum (FPF) [visual guide to practical de-identification](https://fpf.org/2016/04/25/a-visual-guide-to-practical-data-de-identification/) taxonomy is used to evaluate the degree of identifiability of personal data and the types of pseudonymous data, de-identified data and anonymous data. The work of FPF is licensed under a creative commons attribution 4.0 international license."}}, {uri:"https://www.misp-project.org/taxonomies/flesch-reading-ease", properties:{ns0__title:"Flesch Reading Ease is a revised system for determining the comprehension difficulty of written material. The scoring of the flesh score can have a maximum of 121.22 and there is no limit on how low a score can be (negative score are valid)."}}, {uri:"https://www.misp-project.org/taxonomies/maec-delivery-vectors", properties:{ns0__title:"Vectors used to deliver malware based on MAEC 5.0"}}, {uri:"https://www.misp-project.org/taxonomies/dhs-ciip-sectors", properties:{ns0__title:"DHS critical sectors as in https://www.dhs.gov/critical-infrastructure-sectors"}}] AS row
CREATE (n:Resource{uri: row.uri}) SET n += row.properties SET n:skos__ConceptScheme;
UNWIND [{uri:"https://www.misp-project.org/taxonomies/ai-bias-terminology", properties:{ns0__title:"A list of standalone definitions for each type of bias. Aggregate terms that are in common usage or relevance to AI bias. From NIST.SP.1270-draft (2021)"}}, {uri:"https://www.misp-project.org/taxonomies/workflow", properties:{ns0__title:"Workflow support language is a common language to support intelligence analysts to perform their analysis on data and information."}}, {uri:"https://www.misp-project.org/taxonomies/passivetotal", properties:{ns0__title:"Tags from RiskIQ's PassiveTotal service"}}, {uri:"https://www.misp-project.org/taxonomies/approved-category-of-action", properties:{ns0__title:"A pre-approved category of action for indicators being shared with partners (MIMIC)."}}, {uri:"https://www.misp-project.org/taxonomies/cnsd", properties:{ns0__title:"La presente taxonomia es la primera versión disponible para el Centro Nacional de Seguridad Digital del Perú."}}, {uri:"https://www.misp-project.org/taxonomies/gsma-attack-category", properties:{ns0__title:"Taxonomy used by GSMA for their information sharing program with telco describing the attack categories"}}, {uri:"https://www.misp-project.org/taxonomies/deception", properties:{ns0__title:"Deception is an important component of information operations, valuable for both offense and defense. "}}, {uri:"https://www.misp-project.org/taxonomies/cloud-sovereignty", properties:{ns0__title:"Cloud sovereignty objectives, assurance levels, and scoring weights derived from the European Commission Cloud Sovereignty Framework."}}, {uri:"https://www.misp-project.org/taxonomies/rt_event_status", properties:{ns0__title:"Status of events used in Request Tracker."}}, {uri:"https://www.misp-project.org/taxonomies/pfc", properties:{ns0__title:"Le Protocole des feux de circulation (PFC) est basé sur le standard « Traffic Light Protocol (TLP) » conçu par le FIRST. Il a pour objectif d’informer sur les limites autorisées pour la diffusion des informations. Il est classé selon des codes de couleurs."}}, {uri:"https://www.misp-project.org/taxonomies/europol-incident", properties:{ns0__title:"This taxonomy was designed to describe the type of incidents by class."}}, {uri:"https://www.misp-project.org/taxonomies/eu-nis-sector-and-subsectors", properties:{ns0__title:"Sectors, subsectors, and digital services as identified by the NIS Directive"}}, {uri:"https://www.misp-project.org/taxonomies/common-taxonomy", properties:{ns0__title:"Common Taxonomy for Law enforcement and CSIRTs"}}, {uri:"https://www.misp-project.org/taxonomies/csirt_case_classification", properties:{ns0__title:"It is critical that the CSIRT provide consistent and timely response to the customer, and that sensitive information is handled appropriately.  This document provides the guidelines needed for CSIRT Incident Managers (IM) to classify the case category, criticality level, and sensitivity level for each CSIRT case.  This information will be entered into the Incident Tracking System (ITS) when a case is created.  Consistent case classification is required for the CSIRT to provide accurate reporting to management on a regular basis.  In addition, the classifications will provide CSIRT IM’s with proper case handling procedures and will form the basis of SLA’s between the CSIRT and other Company departments."}}, {uri:"https://www.misp-project.org/taxonomies/cryptocurrency-market", properties:{ns0__title:"Crypto Market: A categorisation model for cryptocurrency transactions and risk flags. Taxonomy updated by MISP Project and extended by the JRC (Joint Research Centre) of the European Commission, and subsequently re-extended by the Cátedra Ada Byron UAH-INCIBE."}}, {uri:"https://www.misp-project.org/taxonomies/ms-caro-malware-full", properties:{ns0__title:"Malware Type and Platform classification based on Microsoft's implementation of the Computer Antivirus Research Organization (CARO) Naming Scheme and Malware Terminology. Based on https://www.microsoft.com/en-us/security/portal/mmpc/shared/malwarenaming.aspx, https://www.microsoft.com/security/portal/mmpc/shared/glossary.aspx, https://www.microsoft.com/security/portal/mmpc/shared/objectivecriteria.aspx, and http://www.caro.org/definitions/index.html. Malware families are extracted from Microsoft SIRs since 2008 based on https://www.microsoft.com/security/sir/archive/default.aspx and https://www.microsoft.com/en-us/security/portal/threat/threats.aspx. Note that SIRs do NOT include all Microsoft malware families."}}, {uri:"https://www.misp-project.org/taxonomies/interactive-cyber-training-training-setup", properties:{ns0__title:"The training setup further describes the training itself with the scoring, roles, the training mode as well as the customization level."}}, {uri:"https://www.misp-project.org/taxonomies/analyst-assessment", properties:{ns0__title:"A series of assessment predicates describing the analyst capabilities to perform analysis. These assessment can be assigned by the analyst him/herself or by another party evaluating the analyst."}}, {uri:"https://www.misp-project.org/taxonomies/ifx-vetting", properties:{ns0__title:"The IFX taxonomy is used to categorise information (MISP events and attributes) to aid in the intelligence vetting process"}}, {uri:"https://www.misp-project.org/taxonomies/dcso-sharing", properties:{ns0__title:"Taxonomy defined in the DCSO MISP Event Guide. It provides guidance for the creation and consumption of MISP events in a way that minimises the extra effort for the sending party, while enhancing the usefulness for receiving parties."}}] AS row
CREATE (n:Resource{uri: row.uri}) SET n += row.properties SET n:skos__ConceptScheme;
UNWIND [{uri:"https://www.misp-project.org/taxonomies/course-of-action", properties:{ns0__title:"A Course Of Action analysis considers six potential courses of action for the development of a cyber security capability."}}, {uri:"https://www.misp-project.org/taxonomies/carding", properties:{ns0__title:"Classifying content, activities, tools, and actors within carding forums and marketplaces: A categorisation model for law enforcement. Taxonomy updated by MISP Project and extended by the JRC (Joint Research Centre) of the European Commission, and subsequently re-extended by the Cátedra Ada Byron UAH-INCIBE."}}, {uri:"https://www.misp-project.org/taxonomies/file-type", properties:{ns0__title:"List of known file types."}}, {uri:"https://www.misp-project.org/taxonomies/cti-evaluation", properties:{ns0__title:"Evaluation taxonomy for cyber threat intelligence (CTI) quality and conversion quality in workflows such as MISP/STIX exchange and CTI Transmute, covering relevance, accuracy, timeliness, clarity, specificity, format validity, conversion fidelity, and usefulness."}}, {uri:"https://www.misp-project.org/taxonomies/estimative-language", properties:{ns0__title:"Estimative language to describe quality and credibility of underlying sources, data, and methodologies based Intelligence Community Directive 203 (ICD 203) and JP 2-0, Joint Intelligence"}}, {uri:"https://www.misp-project.org/taxonomies/ais-marking", properties:{ns0__title:"The AIS Marking Schema implementation is maintained by the National Cybersecurity and Communication Integration Center (NCCIC) of the U.S. Department of Homeland Security (DHS)"}}, {uri:"https://www.misp-project.org/taxonomies/acs-marking", properties:{ns0__title:"The Access Control Specification (ACS) marking type defines the object types required to implement automated access control systems based on the relevant policies governing sharing between participants."}}, {uri:"https://www.misp-project.org/taxonomies/csirt-americas", properties:{ns0__title:"Taxonomía CSIRT Américas."}}, {uri:"https://www.misp-project.org/taxonomies/kill-chain", properties:{ns0__title:"The Cyber Kill Chain, a phase-based model developed by Lockheed Martin, aims to help categorise and identify the stage of an attack."}}, {uri:"https://www.misp-project.org/taxonomies/rsit", properties:{ns0__title:"Reference Security Incident Classification Taxonomy"}}, {uri:"https://www.misp-project.org/taxonomies/current-event", properties:{ns0__title:"Current events - Schemes of Classification in Incident Response and Detection"}}, {uri:"https://www.misp-project.org/taxonomies/information-origin", properties:{ns0__title:"Taxonomy for tagging information by its origin: human-generated or AI-generated."}}, {uri:"https://www.misp-project.org/taxonomies/crowdsec", properties:{ns0__title:"Crowdsec IP address classifications and behaviors taxonomy."}}, {uri:"https://www.misp-project.org/taxonomies/agent-threat-rules", properties:{ns0__title:"Agent Threat Rules (ATR) is an open detection standard for AI agent threats published under the MIT licence. The taxonomy organises 713 community-maintained rules across ten attack categories covering prompt injection, tool poisoning, skill compromise, context exfiltration, agent manipulation, privilege escalation, excessive autonomy, model abuse, model security, and data poisoning. Predicates name the category; values are individual rule identifiers in the form ATR-YYYY-NNNNN."}}, {uri:"https://www.misp-project.org/taxonomies/extended-event", properties:{ns0__title:"Reasons why an event has been extended. This taxonomy must be used on the extended event. The competitive analysis aspect is from Psychology of Intelligence Analysis by Richard J. Heuer, Jr. ref:http://www.foo.be/docs/intelligence/PsychofIntelNew.pdf"}}, {uri:"https://www.misp-project.org/taxonomies/dni-ism", properties:{ns0__title:"A subset of Information Security Marking Metadata ISM as required by Executive Order (EO) 13526. As described by DNI.gov as Data Encoding Specifications for Information Security Marking Metadata in Controlled Vocabulary Enumeration Values for ISM"}}, {uri:"https://www.misp-project.org/taxonomies/ce-uas-classification", properties:{ns0__title:"European Union (EASA) Drone Classification - C0 to C6."}}, {uri:"https://www.misp-project.org/taxonomies/admiralty-scale", properties:{ns0__title:"The Admiralty Scale or Ranking (also called the NATO System) is used to rank the reliability of a source and the credibility of an information. Reference based on FM 2-22.3 (FM 34-52) HUMAN INTELLIGENCE COLLECTOR OPERATIONS and NATO documents."}}, {uri:"https://www.misp-project.org/taxonomies/detection-engineering", properties:{ns0__title:"Taxonomy related to detection engineering techniques"}}, {uri:"https://www.misp-project.org/taxonomies/cccs", properties:{ns0__title:"Internal taxonomy for CCCS."}}] AS row
CREATE (n:Resource{uri: row.uri}) SET n += row.properties SET n:skos__ConceptScheme;
UNWIND [{uri:"https://www.misp-project.org/taxonomies/gsma-fraud", properties:{ns0__title:"Taxonomy used by GSMA for their information sharing program with telco describing the various aspects of fraud"}}, {uri:"https://www.misp-project.org/taxonomies/circl", properties:{ns0__title:"CIRCL Taxonomy - Schemes of Classification in Incident Response and Detection."}}, {uri:"https://www.misp-project.org/taxonomies/dga", properties:{ns0__title:"A taxonomy to describe domain-generation algorithms often called DGA. Ref: A Comprehensive Measurement Study of Domain Generating Malware Daniel Plohmann and others."}}, {uri:"https://www.misp-project.org/taxonomies/ransomware-roles", properties:{ns0__title:"The seven roles seen in most ransomware incidents."}}, {uri:"https://www.misp-project.org/taxonomies/scrippsco2-sampling-stations", properties:{ns0__title:"Sampling stations of the Scripps CO2 Program"}}, {uri:"https://www.misp-project.org/taxonomies/runtime-packer", properties:{ns0__title:"Runtime or software packer used to combine compressed or encrypted data with the decompression or decryption code. This code can add additional obfuscations mechanisms including polymorphic-packer, virtualization or other obfuscation techniques. This taxonomy lists all the known or official packer used for legitimate use or for packing malicious binaries."}}, {uri:"https://www.misp-project.org/taxonomies/iab-content-3-1", properties:{ns0__title:"IAB Tech Lab Content Taxonomy 3.1 converted from the official TSV. It provides a common language for describing content or the aboutness of a webpage, application, or video. Source taxonomy © IAB Tech Lab, licensed under Creative Commons Attribution 3.0."}}, {uri:"https://www.misp-project.org/taxonomies/retention", properties:{ns0__title:"Add a retention time to events to automatically remove the IDS-flag on ip-dst or ip-src attributes. We calculate the time elapsed based on the date of the event. Supported time units are: d(ays), w(eeks), m(onths), y(ears). The numerical_value is just for sorting in the web-interface and is not used for calculations."}}, {uri:"https://www.misp-project.org/taxonomies/stealth_malware", properties:{ns0__title:"Classification based on malware stealth techniques. Described in https://vxheaven.org/lib/pdf/Introducing%20Stealth%20Malware%20Taxonomy.pdf"}}, {uri:"https://www.misp-project.org/taxonomies/nis", properties:{ns0__title:"The taxonomy is meant for large scale cybersecurity incidents, as mentioned in the Commission Recommendation of 13 September 2017, also known as the blueprint. It has two core parts: The nature of the incident, i.e. the underlying cause, that triggered the incident, and the impact of the incident, i.e. the impact on services, in which sector(s) of economy and society."}}, {uri:"https://www.misp-project.org/taxonomies/organizational-cyber-harm", properties:{ns0__title:"A taxonomy to classify organizational cyber harms based on categories like physical, economic, psychological, reputational, and social/societal impacts."}}, {uri:"https://www.misp-project.org/taxonomies/priority-level", properties:{ns0__title:"After an incident is scored, it is assigned a priority level. The six levels listed below are aligned with NCCIC, DHS, and the CISS to help provide a common lexicon when discussing incidents. This priority assignment drives NCCIC urgency, pre-approved incident response offerings, reporting requirements, and recommendations for leadership escalation. Generally, incident priority distribution should follow a similar pattern to the graph below. Based on https://www.cisa.gov/news-events/news/cisa-national-cyber-incident-scoring-system-nciss."}}, {uri:"https://www.misp-project.org/taxonomies/rstcloud", properties:{ns0__title:"RST Cloud threat intelligence scoring and verdicts for indicators enriched from RST Cloud. score-total (0-100) is the base score of the RST Cloud decaying models, computed as 100 * (source-confidence * context-confidence * relevance) where each sub-score is in [0,1]; because it is a product the total is heavily compressed (all-very-high inputs 0.9*0.9*0.9 = 72.9), so 90+ is rarely reached. Clients typically use 45+ for real-time detection and 50+ for blocking. context-confidence and relevance are coarse bands derived from the corresponding RST sub-scores and are human triage signals; context-confidence also reflects how dangerous the associated threat type is, and relevance also factors in novelty/freshness. noise-control / noise-category carry RST Noise Control and false-positive verdicts surfaced by the enrichment modules. By RST Cloud."}}, {uri:"https://www.misp-project.org/taxonomies/aviation", properties:{ns0__title:"A taxonomy describing security threats or incidents against the aviation sector."}}, {uri:"https://www.misp-project.org/taxonomies/scrippsco2-fgc", properties:{ns0__title:"Flags describing the sample"}}, {uri:"https://www.misp-project.org/taxonomies/scrippsco2-fgi", properties:{ns0__title:"Flags describing the sample for isotopic data (C14, O18)"}}, {uri:"https://www.misp-project.org/taxonomies/eu-marketop-and-publicadmin", properties:{ns0__title:"Market operators and public administrations that must comply to some notifications requirements under EU NIS directive"}}, {uri:"https://www.misp-project.org/taxonomies/social-engineering-attack-vectors", properties:{ns0__title:"Attack vectors used in social engineering as described in 'A Taxonomy of Social Engineering Defense Mechanisms' by Dalal Alharthi and others."}}, {uri:"https://www.misp-project.org/taxonomies/misp", properties:{ns0__title:"MISP taxonomy to infer with MISP behavior or operation."}}, {uri:"https://www.misp-project.org/taxonomies/exercise", properties:{ns0__title:"Exercise is a taxonomy to describe if the information is part of one or more cyber or crisis exercise."}}] AS row
CREATE (n:Resource{uri: row.uri}) SET n += row.properties SET n:skos__ConceptScheme;
UNWIND [{uri:"https://www.misp-project.org/taxonomies/targeted-threat-index", properties:{ns0__title:"The Targeted Threat Index is a metric for assigning an overall threat ranking score to email messages that deliver malware to a victim’s computer. The TTI metric was first introduced at SecTor 2013 by Seth Hardy as part of the talk “RATastrophe: Monitoring a Malware Menagerie” along with Katie Kleemola and Greg Wiseman."}}, {uri:"https://www.misp-project.org/taxonomies/maec-malware-obfuscation-methods", properties:{ns0__title:"Obfuscation methods used by malware based on MAEC 5.0"}}, {uri:"https://www.misp-project.org/taxonomies/ai-computer-assisted", properties:{ns0__title:"Taxonomy describing the level of AI assistance and the level of review/update involved in the creation of an intelligence package or event."}}, {uri:"https://www.misp-project.org/taxonomies/DML", properties:{ns0__title:"The Detection Maturity Level (DML) model is a capability maturity model for referencing ones maturity in detecting cyber attacks.  It's designed for organizations who perform intel-driven detection and response and who put an emphasis on having a mature detection program."}}, {uri:"https://www.misp-project.org/taxonomies/unified-ransomware-kill-chain", properties:{ns0__title:"The Unified Ransomware Kill Chain, a intelligence driven model developed by Oleg Skulkin, aims to track every single phase of a ransomware attack."}}, {uri:"https://www.misp-project.org/taxonomies/drug-form", properties:{ns0__title:"Primary physical forms of drugs: A categorisation model for narcotics and substances. Taxonomy updated by MISP Project and extended by the JRC (Joint Research Centre) of the European Commission, and subsequently re-extended by the Cátedra Ada Byron UAH-INCIBE."}}, {uri:"https://www.misp-project.org/taxonomies/misinformation-website-label", properties:{ns0__title:"classification for the identification of type of misinformation among websites. Source:False, Misleading, Clickbait-y, and/or Satirical News Sources by Melissa Zimdars 2019"}}, {uri:"https://www.misp-project.org/taxonomies/death-possibilities", properties:{ns0__title:"Taxonomy of Death Possibilities"}}, {uri:"https://www.misp-project.org/taxonomies/mwdb", properties:{ns0__title:"Malware Database (mwdb) Taxonomy - Tags used across the platform"}}, {uri:"https://www.misp-project.org/taxonomies/gdpr", properties:{ns0__title:"Taxonomy related to the REGULATION (EU) 2016/679 OF THE EUROPEAN PARLIAMENT AND OF THE COUNCIL on the protection of natural persons with regard to the processing of personal data and on the free movement of such data, and repealing Directive 95/46/EC (General Data Protection Regulation)"}}, {uri:"https://www.misp-project.org/taxonomies/infoleak", properties:{ns0__title:"A taxonomy describing information leaks and especially information classified as being potentially leaked. The taxonomy is based on the work by CIRCL on the AIL framework. The taxonomy aim is to be used at large to improve classification of leaked information."}}, {uri:"https://www.misp-project.org/taxonomies/false-positive", properties:{ns0__title:"This taxonomy aims to ballpark the expected amount of false positives."}}, {uri:"https://www.misp-project.org/taxonomies/GrayZone", properties:{ns0__title:"Gray Zone of Active defense includes all elements which lay between reactive defense elements and offensive operations. It does fill the gray spot between them. Taxo may be used for active defense planning or modeling."}}, {uri:"https://www.misp-project.org/taxonomies/ptrclassify", properties:{ns0__title:"Explainable classifications inferred from reverse-DNS PTR hostnames."}}, {uri:"https://www.misp-project.org/taxonomies/maec-malware-capabilities", properties:{ns0__title:"Malware Capabilities based on MAEC 5.0"}}, {uri:"https://www.misp-project.org/taxonomies/phishing", properties:{ns0__title:"Taxonomy to classify phishing attacks including techniques, collection mechanisms and analysis status."}}, {uri:"https://www.misp-project.org/taxonomies/enisa", properties:{ns0__title:"The present threat taxonomy is an initial version that has been developed on the basis of available ENISA material. This material has been used as an ENISA-internal structuring aid for information collection and threat consolidation purposes. It emerged in the time period 2012-2015."}}, {uri:"https://www.misp-project.org/taxonomies/sov", properties:{ns0__title:"SoV Cloud sovereignty objectives, assurance levels, and scoring weights derived from the European Commission Cloud Sovereignty Framework."}}, {uri:"https://www.misp-project.org/taxonomies/eu-ai-act", properties:{ns0__title:"Taxonomy for the EU Artificial Intelligence Act (Regulation (EU) 2024/1689). Classifies AI systems by risk level, prohibited practices, high-risk use cases, and incident types for GRC and SOC reporting."}}, {uri:"https://www.misp-project.org/taxonomies/gsma-network-technology", properties:{ns0__title:"Taxonomy used by GSMA for their information sharing program with telco describing the types of infrastructure. WiP"}}] AS row
CREATE (n:Resource{uri: row.uri}) SET n += row.properties SET n:skos__ConceptScheme;
UNWIND [{uri:"https://www.misp-project.org/taxonomies/nis2", properties:{ns0__title:"The taxonomy is meant for large scale cybersecurity incidents, as mentioned in the Commission Recommendation of 13 May 2022, also known as the provisional agreement. It has two core parts: The nature of the incident, i.e. the underlying cause, that triggered the incident, and the impact of the incident, i.e. the impact on services, in which sector(s) of economy and society."}}, {uri:"https://www.misp-project.org/taxonomies/nato-uas-classification", properties:{ns0__title:"NATO UAS Classification."}}, {uri:"https://www.misp-project.org/taxonomies/accessnow", properties:{ns0__title:"Access Now classification to classify an issue (such as security, human rights, youth rights)."}}, {uri:"https://www.misp-project.org/taxonomies/diamond-model", properties:{ns0__title:"The Diamond Model for Intrusion Analysis establishes the basic atomic element of any intrusion activity, the event, composed of four core features: adversary, infrastructure, capability, and victim."}}, {uri:"https://www.misp-project.org/taxonomies/threatmatch", properties:{ns0__title:"The ThreatMatch Sectors, Incident types, Malware types and Alert types are applicable for any ThreatMatch instances and should be used for all CIISI and TIBER Projects."}}, {uri:"https://www.misp-project.org/taxonomies/copine-scale", properties:{ns0__title:"The COPINE Scale is a rating system created in Ireland and used in the United Kingdom to categorise the severity of images of child sex abuse. The scale was developed by staff at the COPINE (Combating Paedophile Information Networks in Europe) project. The COPINE Project was founded in 1997, and is based in the Department of Applied Psychology, University College Cork, Ireland."}}, {uri:"https://www.misp-project.org/taxonomies/event-classification", properties:{ns0__title:"Classification of events as seen in tools such as RT/IR, MISP and other"}}, {uri:"https://www.misp-project.org/taxonomies/content-classification", properties:{ns0__title:"Classification taxonomy for labeling the primary subject matter, intent, market context, and thematic domain of online content, including general information, technology, cybersecurity, cybercrime, markets, communities, finance, illegal markets, technical services, and geopolitical or hacktivist material."}}, {uri:"https://www.misp-project.org/taxonomies/iep2-policy", properties:{ns0__title:"Forum of Incident Response and Security Teams (FIRST) Information Exchange Policy (IEP) v2.0 Policy"}}, {uri:"https://www.misp-project.org/taxonomies/thales_group", properties:{ns0__title:"Thales Group Taxonomy - was designed with the aim of enabling desired sharing and preventing unwanted sharing between Thales Group security communities."}}, {uri:"https://www.misp-project.org/taxonomies/ddos", properties:{ns0__title:"Distributed Denial of Service - or short: DDoS - taxonomy supports the description of Denial of Service attacks and especially the types they belong too."}}, {uri:"https://www.misp-project.org/taxonomies/honeypot-basic", properties:{ns0__title:"Updated (CIRCL, Seamus Dowling and EURECOM) from Christian Seifert, Ian Welch, Peter Komisarczuk, ‘Taxonomy of Honeypots’, Technical Report CS-TR-06/12, VICTORIA UNIVERSITY OF WELLINGTON, School of Mathematical and Computing Sciences, June 2006, http://www.mcs.vuw.ac.nz/comp/Publications/archive/CS-TR-06/CS-TR-06-12.pdf"}}, {uri:"https://www.misp-project.org/taxonomies/pentest", properties:{ns0__title:"Penetration test (pentest) classification."}}, {uri:"https://www.misp-project.org/taxonomies/state-responsibility", properties:{ns0__title:"A spectrum of state responsibility to more directly tie the goals of attribution to the needs of policymakers."}}, {uri:"https://www.misp-project.org/taxonomies/iep2-reference", properties:{ns0__title:"Forum of Incident Response and Security Teams (FIRST) Information Exchange Policy (IEP) v2.0 Reference"}}, {uri:"https://www.misp-project.org/taxonomies/unified-kill-chain", properties:{ns0__title:"The Unified Kill Chain is a refinement to the Kill Chain."}}, {uri:"https://www.misp-project.org/taxonomies/cti", properties:{ns0__title:"Cyber Threat Intelligence cycle to control workflow state of your process."}}, {uri:"https://www.misp-project.org/taxonomies/sentinel-threattype", properties:{ns0__title:"Sentinel indicator threat types."}}, {uri:"https://www.misp-project.org/taxonomies/nato", properties:{ns0__title:"NATO classification markings."}}, {uri:"https://www.misp-project.org/taxonomies/ensoc", properties:{ns0__title:"Official ENSOC (or EU CyberHUB) taxonomy covering all labels used during information exchange."}}] AS row
CREATE (n:Resource{uri: row.uri}) SET n += row.properties SET n:skos__ConceptScheme;
UNWIND [{uri:"https://www.misp-project.org/taxonomies/open_threat", properties:{ns0__title:"Open Threat Taxonomy v1.1 base on James Tarala of SANS http://www.auditscripts.com/resources/open_threat_taxonomy_v1.1a.pdf, https://files.sans.org/summit/Threat_Hunting_Incident_Response_Summit_2016/PDFs/Using-Open-Tools-to-Convert-Threat-Intelligence-into-Practical-Defenses-James-Tarala-SANS-Institute.pdf, https://www.youtube.com/watch?v=5rdGOOFC_yE, and https://www.rsaconference.com/writable/presentations/file_upload/str-r04_using-an-open-source-threat-model-for-prioritized-defense-final.pdf"}}, {uri:"https://www.misp-project.org/taxonomies/vulnerability", properties:{ns0__title:"A taxonomy for describing vulnerabilities (software, hardware, or social) on different scales or with additional available information."}}, {uri:"https://www.misp-project.org/taxonomies/cytomic-orion", properties:{ns0__title:"Taxonomy to describe desired actions for Cytomic Orion"}}, {uri:"https://www.misp-project.org/taxonomies/tor", properties:{ns0__title:"Taxonomy to describe Tor network infrastructure"}}, {uri:"https://www.misp-project.org/taxonomies/coa", properties:{ns0__title:"Course of action taken within organization to discover, detect, deny, disrupt, degrade, deceive and/or destroy an attack."}}, {uri:"https://www.misp-project.org/taxonomies/artificial-satellites", properties:{ns0__title:"This taxonomy was designed to describe artificial satellites"}}, {uri:"https://www.misp-project.org/taxonomies/poison-taxonomy", properties:{ns0__title:"Non-exhaustive taxonomy of natural poison"}}, {uri:"https://www.misp-project.org/taxonomies/ransomware", properties:{ns0__title:"Ransomware is used to define ransomware types and the elements that compose them."}}, {uri:"https://www.misp-project.org/taxonomies/vocabulaire-des-probabilites-estimatives", properties:{ns0__title:"Ce vocabulaire attribue des valeurs en pourcentage à certains énoncés de probabilité"}}, {uri:"https://www.misp-project.org/taxonomies/information-security-data-source", properties:{ns0__title:"Taxonomy to classify the information security data sources."}}, {uri:"https://www.misp-project.org/taxonomies/economical-impact", properties:{ns0__title:"Economic impact refers to a taxonomy used to describe whether financial effects are positive or negative outcomes related to tagged information. For instance, data exfiltration loss represents a positive outcome for an adversary."}}, {uri:"https://www.misp-project.org/taxonomies/domain-abuse", properties:{ns0__title:"Domain Name Abuse - taxonomy to tag domain names used for cybercrime."}}, {uri:"https://www.misp-project.org/taxonomies/misp-workflow", properties:{ns0__title:"MISP workflow taxonomy to support result of workflow execution."}}, {uri:"https://www.misp-project.org/taxonomies/tlp", properties:{ns0__title:"The Traffic Light Protocol (TLP) (v2.0) was created to facilitate greater sharing of potentially sensitive information and more effective collaboration. Information sharing happens from an information source, towards one or more recipients. TLP is a set of four standard labels (a fifth label is included in amber to limit the diffusion) used to indicate the sharing boundaries to be applied by the recipients. Only labels listed in this standard are considered valid by FIRST. This taxonomy includes additional labels for backward compatibility which are no more validated by FIRST SIG."}}, {uri:"https://www.misp-project.org/taxonomies/pandemic", properties:{ns0__title:"Pandemic"}}, {uri:"https://www.misp-project.org/taxonomies/cssa", properties:{ns0__title:"The CSSA agreed sharing taxonomy."}}, {uri:"https://www.misp-project.org/taxonomies/ai-safety-benchmark", properties:{ns0__title:"AI safety benchmark v0.5, that has been created by the MLCommons AI Safety Working Group (WG)"}}, {uri:"https://www.misp-project.org/taxonomies/DFRLab-dichotomies-of-disinformation", properties:{ns0__title:"DFRLab Dichotomies of Disinformation."}}] AS row
CREATE (n:Resource{uri: row.uri}) SET n += row.properties SET n:skos__ConceptScheme;
UNWIND [{uri:"https://cve.mitre.org/CVE-2023-1234", properties:{cyber__description:"Vulnérabilité critique dans OpenSSL 1.0.2 permettant une exécution de code à distance.", cyber__cvssScore:9.8, foaf__name:"CVE-2023-1234"}}] AS row
CREATE (n:Resource{uri: row.uri}) SET n += row.properties SET n:cyber__Vulnerability;
UNWIND [{id:"PC-Alban-POC", properties:{importedAt:datetime('2026-08-19T13:07:13.411Z'), ip:"192.168.1.100", type:"PC"}}, {id:"Router-POC", properties:{importedAt:datetime('2026-08-19T13:07:13.411Z'), ip:"192.168.1.1", type:"Router"}}] AS row
CREATE (n:Device{id: row.id}) SET n += row.properties;
UNWIND [{uri:"https://www.misp-project.org/taxonomies/use-case-applicability", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"use-case-applicability:=\"/\"", ns0__title:"The Use Case Applicability categories reflect standard resolution categories, to clearly display alerting rule configuration problems."}}, {uri:"https://www.misp-project.org/taxonomies/cyber-threat-framework", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"cyber-threat-framework:=\"/\"", ns0__title:"Cyber Threat Framework was developed by the US Government to enable consistent characterization and categorization of cyber threat events, and to identify trends or changes in the activities of cyber adversaries. https://www.dni.gov/index.php/cyber-threat-framework"}}, {uri:"https://www.misp-project.org/taxonomies/euci", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"euci:=\"/\"", ns0__title:"EU classified information (EUCI) means any information or material designated by a EU security classification, the unauthorised disclosure of which could cause varying degrees of prejudice to the interests of the European Union or of one or more of the Member States."}}, {uri:"https://www.misp-project.org/taxonomies/action-taken", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"action-taken:=\"/\"", ns0__title:"Action taken in the case of a security incident (CSIRT perspective)."}}, {uri:"https://www.misp-project.org/taxonomies/drugs", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"drugs:=\"/\"", ns0__title:"A taxonomy based on the superclass and class of drugs. Based on https://www.drugbank.ca/releases/latest"}}] AS row
CREATE (n:Resource{uri: row.uri}) SET n += row.properties SET n:skos__ConceptScheme:skos__Concept;
UNWIND [{_id:18, properties:{_classLabel:"Class", _handleRDFTypes:0, _subClassOfRel:"SCO", _objectPropertyLabel:"Relationship", _handleMultival:0, _rangeRel:"RANGE", _domainRel:"DOMAIN", _keepLangTag:false, _keepCustomDataTypes:false, _classNamePropName:"name", _handleVocabUris:0, _applyNeo4jNaming:false, _relNamePropName:"name", _dataTypePropertyLabel:"Property", _subPropertyOfRel:"SPO"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:_GraphConfig;
