UNWIND [{uri:"https://www.misp-project.org/taxonomies/drugs/-", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"drugs:=\"-\""}}, {uri:"https://www.misp-project.org/taxonomies/scrippsco2-fgi/5", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"scrippsco2-fgi:=\"5\""}}, {uri:"https://www.misp-project.org/taxonomies/scrippsco2-fgi/6", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"scrippsco2-fgi:=\"6\""}}, {uri:"https://www.misp-project.org/taxonomies/scrippsco2-fgi/0", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"scrippsco2-fgi:=\"0\""}}, {uri:"https://www.misp-project.org/taxonomies/scrippsco2-fgi/3", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"scrippsco2-fgi:=\"3\""}}, {uri:"https://www.misp-project.org/taxonomies/scrippsco2-fgi/-", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"scrippsco2-fgi:=\"-\""}}, {uri:"https://www.misp-project.org/taxonomies/drugs/1", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"drugs:=\"1\""}}, {uri:"https://www.misp-project.org/taxonomies/drugs/3", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"drugs:=\"3\""}}, {uri:"https://www.misp-project.org/taxonomies/scrippsco2-fgi/9", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"scrippsco2-fgi:=\"9\""}}, {uri:"https://www.misp-project.org/taxonomies/scrippsco2-fgi/8", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"scrippsco2-fgi:=\"8\""}}, {uri:"https://www.misp-project.org/taxonomies/ddos/y", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"ddos:=\"y\""}}, {uri:"https://www.misp-project.org/taxonomies/vocabulaire-des-probabilites-estimatives/-", properties:{ns0__source:"MISP Taxonomies (GitHub)", skos__prefLabel:"vocabulaire-des-probabilites-estimatives:=\"-\""}}, {uri:"https://www.misp-project.org/taxonomies/ddos/e", properties:{ns0__source:"MISP Taxonomie