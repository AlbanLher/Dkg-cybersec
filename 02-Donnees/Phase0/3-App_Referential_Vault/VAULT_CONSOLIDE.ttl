    skos:prefLabel "🌐 Référentiels Publics Externe Intégrés au Lexique SKOS"@fr .

<http://example.org/entreprise-ontology#CriticalAsset> a owl:Class ;
    rdfs:label "Actif Criticalité Métier Haute"@fr ;
    rdfs:subClassOf :Device .

<http://example.org/entreprise-ontology#PriveeOntology> a owl:Ontology ;
    rdfs:label "Ontologie Cybersécurité Privée / Métier - Phase 0"@fr ;
    owl:imports <http://example.org/cyber-ontology> .

<http://example.org/entreprise-ontology#businessOwner> a owl:DatatypeProperty ;
    rdfs:domain :Device .

cve:CVE-2023-1234 a :Vulnerability ;
    :cvssScore 9.8 ;
    :description "Vulnérabilité critique dans OpenSSL 1.0.2 permettant une exécution de code à distance." ;
    foaf:name "CVE-2023-1234" .

<https://www.misp-project.org/taxonomies/CERT-XLM/-> a skos:Concept ;
    dcterms:source "MISP Taxonomies (GitHub)"@fr ;
