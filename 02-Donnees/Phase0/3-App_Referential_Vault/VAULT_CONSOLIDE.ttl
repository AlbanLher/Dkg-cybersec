:Action a owl:Class ;
    rdfs:label "Action corrective" .

:Software a owl:Class ;
    rdfs:label "Logiciel" .

:Threat a owl:Class ;
    rdfs:label "Menace" .

:Device a owl:Class ;
    rdfs:label "Appareil",
        "Équipement Système"@fr ;
    rdfs:comment "Un device physique ou virtuel (PC, routeur, serveur)." .

:Vulnerability a owl:Class ;
    rdfs:label "Vulnérabilité",
        "Vulnérabilité Sécurité"@fr ;
    rdfs:subClassOf :Threat .

ex1:Scheme_LEXIQUE_PRIVEE a skos:ConceptScheme ;
    dcterms:title "Lexique SKOS - LEXIQUE_PRIVEE"@fr .

ex1:Scheme_LEXIQUE_PUBLIQUE a skos:ConceptScheme ;
    dcterms:title "Lexique SKOS - LEXIQUE_PUBLIQUE"@fr .

misp:binary-class a skos:ConceptScheme ;
    dcterms:title "Custom taxonomy for types of binary file."@en .

misp:ddos a skos:ConceptScheme ;
    dcterms:title "Distributed Denial of Service - or short: DDoS - taxonomy supports the description of Denial of Service attacks and especially the types they belong too."@en .

misp:drug-form a skos:ConceptScheme ;
    dcterms:title "Primary physical forms of drugs: A categorisation model for narcotics and substances. Taxonomy updated by MISP Project and extended by the JRC (Joint Research Centre) of the European Commission, and subsequently re-extended by the Cátedra Ada Byron UAH-INCIBE."@en .

misp:file-type a skos:ConceptScheme ;
    dcterms:title "List of known file types."@en .

misp:stealth_malware a skos:ConceptScheme ;
    dcterms:title "Classification based on malware stealth techniques. Described in https://vxheaven.org/lib/pdf/Introducing%20Stealth%20Malware%20Taxonomy.pdf"@en .

misp:flesch-reading-ease a skos:ConceptScheme ;
    dcterms:title "Flesch Reading Ease is a revised system for determining the comprehension difficulty of written material. The scoring of the flesh score can have a maximum of 121.22 and there is no limit on how low a score can be (negative score are valid)."@en .

misp:collaborative-intelligence a skos:ConceptScheme ;
    dcterms:title "Collaborative intelligence support language is a common language to support analysts to perform their analysis to get crowdsourced support when using threat intelligence sharing platform like MISP. The objective of this language is to advance collaborative analysis and to share earlier than later."@en .

misp:cytomic-orion a skos:ConceptScheme ;
    dcterms:title "Taxonomy to describe desired actions for Cytomic Orion"@en .

misp:nato-uas-classification a skos:ConceptScheme ;
    dcterms:title "NATO UAS Classification."@en .

misp:workflow a skos:ConceptScheme ;
    dcterms:title "Workflow support language is a common language to support intelligence analysts to perform their analysis on data and information."@en .

misp:cycat a skos:ConceptScheme ;
    dcterms:title "Taxonomy used by CyCAT, the Universal Cybersecurity Resource Catalogue, to categorize the namespaces it supports and uses."@en .

misp:dcso-sharing a skos:ConceptScheme ;
    dcterms:title "Taxonomy defined in the DCSO MISP Event Guide. It provides guidance for the creation and consumption of MISP events in a way that minimises the extra effort for the sending party, while enhancing the usefulness for receiving parties."@en .

misp:economical-impact a skos:ConceptScheme ;
    dcterms:title "Economic impact refers to a taxonomy used to describe whether financial effects are positive or negative outcomes related to tagged information. For instance, data exfiltration loss represents a positive outcome for an adversary."@en .

misp:iab-content-3-0-descriptive-vectors a skos:ConceptScheme ;
    dcterms:title "IAB Tech Lab Content Taxonomy 3.0 Descriptive Vectors converted from the official TSV. Source taxonomy © IAB Tech Lab, licensed under Creative Commons Attribution 3.0."@en .

misp:iot a skos:ConceptScheme ;
    dcterms:title "Internet of Things taxonomy, based on IOT UK report https://iotuk.org.uk/wp-content/uploads/2017/01/IOT-Taxonomy-Report.pdf"@en .

misp:scrippsco2-fgi a skos:ConceptScheme ;
    dcterms:title "Flags describing the sample for isotopic data (C14, O18)"@en .

misp:ce-uas-classification a skos:ConceptScheme ;
    dcterms:title "European Union (EASA) Drone Classification - C0 to C6."@en .

misp:course-of-action a skos:ConceptScheme ;
    dcterms:title "A Course Of Action analysis considers six potential courses of action for the development of a cyber security capability."@en .

misp:euci a skos:Concept,
        skos:ConceptScheme ;
    dcterms:source "MISP Taxonomies (GitHub)"@fr ;
    dcterms:title "EU classified information (EUCI) means any information or material designated by a EU security classification, the unauthorised disclosure of which could cause varying degrees of prejudice to the interests of the European Union or of one or more of the Member States."@en ;
    skos:inScheme misp:euci ;
    skos:prefLabel "euci:=\"/\""@en .

misp:ifx-vetting a skos:ConceptScheme ;
    dcterms:title "The IFX taxonomy is used to categorise information (MISP events and attributes) to aid in the intelligence vetting process"@en .

misp:pandemic a skos:ConceptScheme ;
    dcterms:title "Pandemic"@en .

misp:rt_event_status a skos:ConceptScheme ;
    dcterms:title "Status of events used in Request Tracker."@en .

misp:DML a skos:ConceptScheme ;
    dcterms:title "The Detection Maturity Level (DML) model is a capability maturity model for referencing ones maturity in detecting cyber attacks.  It's designed for organizations who perform intel-driven detection and response and who put an emphasis on having a mature detection program."@en .

misp:approved-category-of-action a skos:ConceptScheme ;
    dcterms:title "A pre-approved category of action for indicators being shared with partners (MIMIC)."@en .

misp:event-classification a skos:ConceptScheme ;
    dcterms:title "Classification of events as seen in tools such as RT/IR, MISP and other"@en .

misp:ioc a skos:ConceptScheme ;
    dcterms:title "An IOC classification to facilitate automation of malicious and non malicious artifacts"@en .

misp:meteorstorm a skos:ConceptScheme ;
    dcterms:title "Multiple Environment Threat Evaluation of Resources Space Threats and Operational Risk to Missions (meteorstorm) taxonomy for modeling space, cyber, and multi-domain threats and resilience across five layers: Primary Capability Environment (PCE), Segment (SEG), Service (SVC), Asset (AST), and Analytic (AN)."@en .

misp:nato a skos:ConceptScheme ;
    dcterms:title "NATO classification markings."@en .

misp:tor a skos:ConceptScheme ;
    dcterms:title "Taxonomy to describe Tor network infrastructure"@en .

misp:scrippsco2-fgc a skos:ConceptScheme ;
    dcterms:title "Flags describing the sample"@en .

misp:social-engineering-attack-vectors a skos:ConceptScheme ;
    dcterms:title "Attack vectors used in social engineering as described in 'A Taxonomy of Social Engineering Defense Mechanisms' by Dalal Alharthi and others."@en .

misp:ai-bias-terminology a skos:ConceptScheme ;
    dcterms:title "A list of standalone definitions for each type of bias. Aggregate terms that are in common usage or relevance to AI bias. From NIST.SP.1270-draft (2021)"@en .

misp:current-event a skos:ConceptScheme ;
    dcterms:title "Current events - Schemes of Classification in Incident Response and Detection"@en .

misp:false-positive a skos:ConceptScheme ;
    dcterms:title "This taxonomy aims to ballpark the expected amount of false positives."@en .

misp:stix-ttp a skos:ConceptScheme ;
    dcterms:title "TTPs are representations of the behavior or modus operandi of cyber adversaries."@en .

misp:ai-computer-assisted a skos:ConceptScheme ;
    dcterms:title "Taxonomy describing the level of AI assistance and the level of review/update involved in the creation of an intelligence package or event."@en .

misp:detection-engineering a skos:ConceptScheme ;
    dcterms:title "Taxonomy related to detection engineering techniques"@en .

misp:fr-classif a skos:ConceptScheme ;
    dcterms:title "French gov information classification system"@en .

misp:gdpr a skos:ConceptScheme ;
    dcterms:title "Taxonomy related to the REGULATION (EU) 2016/679 OF THE EUROPEAN PARLIAMENT AND OF THE COUNCIL on the protection of natural persons with regard to the processing of personal data and on the free movement of such data, and repealing Directive 95/46/EC (General Data Protection Regulation)"@en .

misp:incident-disposition a skos:ConceptScheme ;
    dcterms:title "How an incident is classified in its process to be resolved. The taxonomy is inspired from NASA Incident Response and Management Handbook. https://www.nasa.gov/pdf/589502main_ITS-HBK-2810.09-02%20%5bNASA%20Information%20Security%20Incident%20Management%5d.pdf#page=9"@en .

misp:ms-caro-malware a skos:ConceptScheme ;
    dcterms:title "Malware Type and Platform classification based on Microsoft's implementation of the Computer Antivirus Research Organization (CARO) Naming Scheme and Malware Terminology. Based on https://www.microsoft.com/en-us/security/portal/mmpc/shared/malwarenaming.aspx, https://www.microsoft.com/security/portal/mmpc/shared/glossary.aspx, https://www.microsoft.com/security/portal/mmpc/shared/objectivecriteria.aspx, and http://www.caro.org/definitions/index.html. Malware families are extracted from Microsoft SIRs since 2008 based on https://www.microsoft.com/security/sir/archive/default.aspx and https://www.microsoft.com/en-us/security/portal/threat/threats.aspx. Note that SIRs do NOT include all Microsoft malware families."@en .

misp:open_threat a skos:ConceptScheme ;
    dcterms:title "Open Threat Taxonomy v1.1 base on James Tarala of SANS http://www.auditscripts.com/resources/open_threat_taxonomy_v1.1a.pdf, https://files.sans.org/summit/Threat_Hunting_Incident_Response_Summit_2016/PDFs/Using-Open-Tools-to-Convert-Threat-Intelligence-into-Practical-Defenses-James-Tarala-SANS-Institute.pdf, https://www.youtube.com/watch?v=5rdGOOFC_yE, and https://www.rsaconference.com/writable/presentations/file_upload/str-r04_using-an-open-source-threat-model-for-prioritized-defense-final.pdf"@en .

misp:poison-taxonomy a skos:ConceptScheme ;
    dcterms:title "Non-exhaustive taxonomy of natural poison"@en .

ex1:Scheme_LEXIQUE_TECHNIQUE a skos:ConceptScheme ;
    dcterms:title "Lexique SKOS - LEXIQUE_TECHNIQUE"@fr .

misp:dark-web a skos:ConceptScheme ;
    dcterms:title "Criminal motivation and content detection the dark web: A categorisation model for law enforcement. ref: Janis Dalins, Campbell Wilson, Mark Carman. Taxonomy updated by MISP Project and extended by the JRC (Joint Research Centre) of the European Commission."@en .

misp:dhs-ciip-sectors a skos:ConceptScheme ;
    dcterms:title "DHS critical sectors as in https://www.dhs.gov/critical-infrastructure-sectors"@en .

misp:domain-abuse a skos:ConceptScheme ;
    dcterms:title "Domain Name Abuse - taxonomy to tag domain names used for cybercrime."@en .

misp:iep2-reference a skos:ConceptScheme ;
    dcterms:title "Forum of Incident Response and Security Teams (FIRST) Information Exchange Policy (IEP) v2.0 Reference"@en .

misp:interactive-cyber-training-training-environment a skos:ConceptScheme ;
    dcterms:title "The training environment details the environment around the training, consisting of training type and scenario."@en .

misp:maec-delivery-vectors a skos:ConceptScheme ;
    dcterms:title "Vectors used to deliver malware based on MAEC 5.0"@en .

misp:maec-malware-behavior a skos:ConceptScheme ;
    dcterms:title "Malware behaviours based on MAEC 5.0"@en .

misp:maec-malware-capabilities a skos:ConceptScheme ;
    dcterms:title "Malware Capabilities based on MAEC 5.0"@en .

misp:ms-caro-malware-full a skos:ConceptScheme ;
    dcterms:title "Malware Type and Platform classification based on Microsoft's implementation of the Computer Antivirus Research Organization (CARO) Naming Scheme and Malware Terminology. Based on https://www.microsoft.com/en-us/security/portal/mmpc/shared/malwarenaming.aspx, https://www.microsoft.com/security/portal/mmpc/shared/glossary.aspx, https://www.microsoft.com/security/portal/mmpc/shared/objectivecriteria.aspx, and http://www.caro.org/definitions/index.html. Malware families are extracted from Microsoft SIRs since 2008 based on https://www.microsoft.com/security/sir/archive/default.aspx and https://www.microsoft.com/en-us/security/portal/threat/threats.aspx. Note that SIRs do NOT include all Microsoft malware families."@en .

misp:mwdb a skos:ConceptScheme ;
    dcterms:title "Malware Database (mwdb) Taxonomy - Tags used across the platform"@en .

misp:srbcert a skos:ConceptScheme ;
    dcterms:title "SRB-CERT Taxonomy - Schemes of Classification in Incident Response and Detection"@en .

misp:vocabulaire-des-probabilites-estimatives a skos:ConceptScheme ;
    dcterms:title "Ce vocabulaire attribue des valeurs en pourcentage à certains énoncés de probabilité"@en .

misp:PAP a skos:ConceptScheme ;
    dcterms:title "The Permissible Actions Protocol - or short: PAP - was designed to indicate how the received information can be used."@en .

misp:adversary a skos:ConceptScheme ;
    dcterms:title "An overview and description of the adversary infrastructure"@en .

misp:circl a skos:ConceptScheme ;
    dcterms:title "CIRCL Taxonomy - Schemes of Classification in Incident Response and Detection."@en .

misp:cloud-sovereignty a skos:ConceptScheme ;
    dcterms:title "Cloud sovereignty objectives, assurance levels, and scoring weights derived from the European Commission Cloud Sovereignty Framework."@en .

misp:copine-scale a skos:ConceptScheme ;
    dcterms:title "The COPINE Scale is a rating system created in Ireland and used in the United Kingdom to categorise the severity of images of child sex abuse. The scale was developed by staff at the COPINE (Combating Paedophile Information Networks in Europe) project. The COPINE Project was founded in 1997, and is based in the Department of Applied Psychology, University College Cork, Ireland."@en .

misp:dga a skos:ConceptScheme ;
    dcterms:title "A taxonomy to describe domain-generation algorithms often called DGA. Ref: A Comprehensive Measurement Study of Domain Generating Malware Daniel Plohmann and others."@en .

misp:niso-credit a skos:ConceptScheme ;
    dcterms:title "NISO CRediT (Contributor Roles Taxonomy) roles for describing contributor roles and optional contribution degrees in scholarly outputs."@en .

misp:sov a skos:ConceptScheme ;
    dcterms:title "SoV Cloud sovereignty objectives, assurance levels, and scoring weights derived from the European Commission Cloud Sovereignty Framework."@en .

misp:coa a skos:ConceptScheme ;
    dcterms:title "Course of action taken within organization to discover, detect, deny, disrupt, degrade, deceive and/or destroy an attack."@en .

misp:cryptocurrency-market a skos:ConceptScheme ;
    dcterms:title "Crypto Market: A categorisation model for cryptocurrency transactions and risk flags. Taxonomy updated by MISP Project and extended by the JRC (Joint Research Centre) of the European Commission, and subsequently re-extended by the Cátedra Ada Byron UAH-INCIBE."@en .

misp:cssa a skos:ConceptScheme ;
    dcterms:title "The CSSA agreed sharing taxonomy."@en .

misp:de-vs a skos:ConceptScheme ;
    dcterms:title "German (DE) Government classification markings (VS)."@en .

misp:event-assessment a skos:ConceptScheme ;
    dcterms:title "A series of assessment predicates describing the event assessment performed to make judgement(s) under a certain level of uncertainty."@en .

misp:gsma-fraud a skos:ConceptScheme ;
    dcterms:title "Taxonomy used by GSMA for their information sharing program with telco describing the various aspects of fraud"@en .

misp:iab-ad-product-2-0 a skos:ConceptScheme ;
    dcterms:title "IAB Tech Lab Ad Product Taxonomy 2.0 converted from the official TSV. It establishes standardized nomenclature for describing the product or service advertised within a creative unit. Source taxonomy © IAB Tech Lab, licensed under Creative Commons Attribution 3.0."@en .

misp:maec-malware-obfuscation-methods a skos:ConceptScheme ;
    dcterms:title "Obfuscation methods used by malware based on MAEC 5.0"@en .

misp:pfc a skos:ConceptScheme ;
    dcterms:title "Le Protocole des feux de circulation (PFC) est basé sur le standard « Traffic Light Protocol (TLP) » conçu par le FIRST. Il a pour objectif d’informer sur les limites autorisées pour la diffusion des informations. Il est classé selon des codes de couleurs."@en .

misp:retention a skos:ConceptScheme ;
    dcterms:title "Add a retention time to events to automatically remove the IDS-flag on ip-dst or ip-src attributes. We calculate the time elapsed based on the date of the event. Supported time units are: d(ays), w(eeks), m(onths), y(ears). The numerical_value is just for sorting in the web-interface and is not used for calculations."@en .

misp:trust a skos:ConceptScheme ;
    dcterms:title "The Indicator of Trust provides insight about data on what can be trusted and known as a good actor. Similar to a whitelist but on steroids, reusing features one would use with Indicators of Compromise, but to filter out what is known to be good."@en .

misp:vmray a skos:ConceptScheme ;
    dcterms:title "VMRay taxonomies to map VMRay Thread Identifier scores and artifacts."@en .

misp:crowdsec a skos:ConceptScheme ;
    dcterms:title "Crowdsec IP address classifications and behaviors taxonomy."@en .

misp:csirt_case_classification a skos:ConceptScheme ;
    dcterms:title "It is critical that the CSIRT provide consistent and timely response to the customer, and that sensitive information is handled appropriately.  This document provides the guidelines needed for CSIRT Incident Managers (IM) to classify the case category, criticality level, and sensitivity level for each CSIRT case.  This information will be entered into the Incident Tracking System (ITS) when a case is created.  Consistent case classification is required for the CSIRT to provide accurate reporting to management on a regular basis.  In addition, the classifications will provide CSIRT IM’s with proper case handling procedures and will form the basis of SLA’s between the CSIRT and other Company departments."@en .

misp:failure-mode-in-machine-learning a skos:ConceptScheme ;
    dcterms:title "The purpose of this taxonomy is to jointly tabulate both the of these failure modes in a single place. Intentional failures wherein the failure is caused by an active adversary attempting to subvert the system to attain her goals – either to misclassify the result, infer private training data, or to steal the underlying algorithm. Unintentional failures wherein the failure is because an ML system produces a formally correct but completely unsafe outcome."@en .

misp:iab-audience-1-1 a skos:ConceptScheme ;
    dcterms:title "IAB Tech Lab Audience Taxonomy 1.1 converted from the official TSV. It provides common nomenclature for audience segment names to improve comparability across data providers. Source taxonomy © IAB Tech Lab, licensed under Creative Commons Attribution 3.0."@en .

misp:information-origin a skos:ConceptScheme ;
    dcterms:title "Taxonomy for tagging information by its origin: human-generated or AI-generated."@en .

misp:information-security-indicators a skos:ConceptScheme ;
    dcterms:title "A full set of operational indicators for organizations to use to benchmark their security posture."@en .

misp:misp-workflow a skos:ConceptScheme ;
    dcterms:title "MISP workflow taxonomy to support result of workflow execution."@en .

misp:osint a skos:ConceptScheme ;
    dcterms:title "Open Source Intelligence - Classification (MISP taxonomies)"@en .

misp:runtime-packer a skos:ConceptScheme ;
    dcterms:title "Runtime or software packer used to combine compressed or encrypted data with the decompression or decryption code. This code can add additional obfuscations mechanisms including polymorphic-packer, virtualization or other obfuscation techniques. This taxonomy lists all the known or official packer used for legitimate use or for packing malicious binaries."@en .

misp:threatmatch a skos:ConceptScheme ;
    dcterms:title "The ThreatMatch Sectors, Incident types, Malware types and Alert types are applicable for any ThreatMatch instances and should be used for all CIISI and TIBER Projects."@en .

misp:type a skos:ConceptScheme ;
    dcterms:title "Taxonomy to describe different types of intelligence gathering discipline which can be described the origin of intelligence."@en .

misp:admiralty-scale a skos:ConceptScheme ;
    dcterms:title "The Admiralty Scale or Ranking (also called the NATO System) is used to rank the reliability of a source and the credibility of an information. Reference based on FM 2-22.3 (FM 34-52) HUMAN INTELLIGENCE COLLECTOR OPERATIONS and NATO documents."@en .

misp:deception a skos:ConceptScheme ;
    dcterms:title "Deception is an important component of information operations, valuable for both offense and defense. "@en .

misp:ensoc a skos:ConceptScheme ;
    dcterms:title "Official ENSOC (or EU CyberHUB) taxonomy covering all labels used during information exchange."@en .

misp:interactive-cyber-training-training-setup a skos:ConceptScheme ;
    dcterms:title "The training setup further describes the training itself with the scoring, roles, the training mode as well as the customization level."@en .

misp:passivetotal a skos:ConceptScheme ;
    dcterms:title "Tags from RiskIQ's PassiveTotal service"@en .

misp:political-spectrum a skos:ConceptScheme ;
    dcterms:title "A political spectrum is a system to characterize and classify different political positions in relation to one another."@en .

misp:rstcloud a skos:ConceptScheme ;
    dcterms:title "RST Cloud threat intelligence scoring and verdicts for indicators enriched from RST Cloud. score-total (0-100) is the base score of the RST Cloud decaying models, computed as 100 * (source-confidence * context-confidence * relevance) where each sub-score is in [0,1]; because it is a product the total is heavily compressed (all-very-high inputs 0.9*0.9*0.9 = 72.9), so 90+ is rarely reached. Clients typically use 45+ for real-time detection and 50+ for blocking. context-confidence and relevance are coarse bands derived from the corresponding RST sub-scores and are human triage signals; context-confidence also reflects how dangerous the associated threat type is, and relevance also factors in novelty/freshness. noise-control / noise-category carry RST Noise Control and false-positive verdicts surfaced by the enrichment modules. By RST Cloud."@en .

misp:analyst-assessment a skos:ConceptScheme ;
    dcterms:title "A series of assessment predicates describing the analyst capabilities to perform analysis. These assessment can be assigned by the analyst him/herself or by another party evaluating the analyst."@en .

misp:data-classification a skos:ConceptScheme ;
    dcterms:title "Data classification for data potentially at risk of exfiltration based on table 2.1 of Solving Cyber Risk book."@en .

misp:eu-marketop-and-publicadmin a skos:ConceptScheme ;
    dcterms:title "Market operators and public administrations that must comply to some notifications requirements under EU NIS directive"@en .

misp:fpf a skos:ConceptScheme ;
    dcterms:title "The Future of Privacy Forum (FPF) [visual guide to practical de-identification](https://fpf.org/2016/04/25/a-visual-guide-to-practical-data-de-identification/) taxonomy is used to evaluate the degree of identifiability of personal data and the types of pseudonymous data, de-identified data and anonymous data. The work of FPF is licensed under a creative commons attribution 4.0 international license."@en .

misp:honeypot-basic a skos:ConceptScheme ;
    dcterms:title "Updated (CIRCL, Seamus Dowling and EURECOM) from Christian Seifert, Ian Welch, Peter Komisarczuk, ‘Taxonomy of Honeypots’, Technical Report CS-TR-06/12, VICTORIA UNIVERSITY OF WELLINGTON, School of Mathematical and Computing Sciences, June 2006, http://www.mcs.vuw.ac.nz/comp/Publications/archive/CS-TR-06/CS-TR-06-12.pdf"@en .

misp:iab-content-3-1 a skos:ConceptScheme ;
    dcterms:title "IAB Tech Lab Content Taxonomy 3.1 converted from the official TSV. It provides a common language for describing content or the aboutness of a webpage, application, or video. Source taxonomy © IAB Tech Lab, licensed under Creative Commons Attribution 3.0."@en .

misp:infoleak a skos:ConceptScheme ;
    dcterms:title "A taxonomy describing information leaks and especially information classified as being potentially leaked. The taxonomy is based on the work by CIRCL on the AIL framework. The taxonomy aim is to be used at large to improve classification of leaked information."@en .

misp:interactive-cyber-training-audience a skos:ConceptScheme ;
    dcterms:title "Describes the target of cyber training and education."@en .

misp:interactive-cyber-training-technical-setup a skos:ConceptScheme ;
    dcterms:title "The technical setup consists of environment structure, deployment, and orchestration."@en .

misp:nis a skos:ConceptScheme ;
    dcterms:title "The taxonomy is meant for large scale cybersecurity incidents, as mentioned in the Commission Recommendation of 13 September 2017, also known as the blueprint. It has two core parts: The nature of the incident, i.e. the underlying cause, that triggered the incident, and the impact of the incident, i.e. the impact on services, in which sector(s) of economy and society."@en .

misp:organizational-cyber-harm a skos:ConceptScheme ;
    dcterms:title "A taxonomy to classify organizational cyber harms based on categories like physical, economic, psychological, reputational, and social/societal impacts."@en .

misp:scrippsco2-sampling-stations a skos:ConceptScheme ;
    dcterms:title "Sampling stations of the Scripps CO2 Program"@en .

misp:smart-airports-threats a skos:ConceptScheme ;
    dcterms:title "Threat taxonomy in the scope of securing smart airports by ENISA. https://www.enisa.europa.eu/publications/securing-smart-airports"@en .

misp:targeted-threat-index a skos:ConceptScheme ;
    dcterms:title "The Targeted Threat Index is a metric for assigning an overall threat ranking score to email messages that deliver malware to a victim’s computer. The TTI metric was first introduced at SecTor 2013 by Seth Hardy as part of the talk “RATastrophe: Monitoring a Malware Menagerie” along with Katie Kleemola and Greg Wiseman."@en .

misp:threats-to-dns a skos:ConceptScheme ;
    dcterms:title "An overview of some of the known attacks related to DNS as described by Torabi, S., Boukhtouta, A., Assi, C., & Debbabi, M. (2018) in Detecting Internet Abuse by Analyzing Passive DNS Traffic: A Survey of Implemented Systems. IEEE Communications Surveys & Tutorials, 1–1. doi:10.1109/comst.2018.2849614"@en .

misp:anti-piracy a skos:ConceptScheme ;
    dcterms:title "Taxonomy for anti-piracy"@en .

misp:carding a skos:ConceptScheme ;
    dcterms:title "Classifying content, activities, tools, and actors within carding forums and marketplaces: A categorisation model for law enforcement. Taxonomy updated by MISP Project and extended by the JRC (Joint Research Centre) of the European Commission, and subsequently re-extended by the Cátedra Ada Byron UAH-INCIBE."@en .

misp:cyber-threat-framework a skos:Concept,
        skos:ConceptScheme ;
    dcterms:source "MISP Taxonomies (GitHub)"@fr ;
    dcterms:title "Cyber Threat Framework was developed by the US Government to enable consistent characterization and categorization of cyber threat events, and to identify trends or changes in the activities of cyber adversaries. https://www.dni.gov/index.php/cyber-threat-framework"@en ;
    skos:inScheme misp:cyber-threat-framework ;
    skos:prefLabel "cyber-threat-framework:=\"/\""@en .

misp:diamond-model-for-influence-operations a skos:ConceptScheme ;
    dcterms:title "The diamond model for influence operations analysis is a framework that leads analysts and researchers toward a comprehensive understanding of a malign influence campaign by addressing the socio-political, technical, and psychological aspects of the campaign. The diamond model for influence operations analysis consists of 5 components: 4 corners and a core element. The 4 corners are divided into 2 axes: influencer and audience on the socio-political axis, capabilities and infrastructure on the technical axis. Narrative makes up the core of the diamond."@en .

misp:financial a skos:ConceptScheme ;
    dcterms:title "Financial taxonomy to describe financial services, infrastructure and financial scope."@en .

misp:interception-method a skos:ConceptScheme ;
    dcterms:title "The interception method used to intercept traffic."@en .

misp:nis2 a skos:ConceptScheme ;
    dcterms:title "The taxonomy is meant for large scale cybersecurity incidents, as mentioned in the Commission Recommendation of 13 May 2022, also known as the provisional agreement. It has two core parts: The nature of the incident, i.e. the underlying cause, that triggered the incident, and the impact of the incident, i.e. the impact on services, in which sector(s) of economy and society."@en .

misp:priority-level a skos:ConceptScheme ;
    dcterms:title "After an incident is scored, it is assigned a priority level. The six levels listed below are aligned with NCCIC, DHS, and the CISS to help provide a common lexicon when discussing incidents. This priority assignment drives NCCIC urgency, pre-approved incident response offerings, reporting requirements, and recommendations for leadership escalation. Generally, incident priority distribution should follow a similar pattern to the graph below. Based on https://www.cisa.gov/news-events/news/cisa-national-cyber-incident-scoring-system-nciss."@en .

misp:ptrclassify a skos:ConceptScheme ;
    dcterms:title "Explainable classifications inferred from reverse-DNS PTR hostnames."@en .

misp:ransomware a skos:ConceptScheme ;
    dcterms:title "Ransomware is used to define ransomware types and the elements that compose them."@en .

misp:state-responsibility a skos:ConceptScheme ;
    dcterms:title "A spectrum of state responsibility to more directly tie the goals of attribution to the needs of policymakers."@en .

misp:tlp a skos:ConceptScheme ;
    dcterms:title "The Traffic Light Protocol (TLP) (v2.0) was created to facilitate greater sharing of potentially sensitive information and more effective collaboration. Information sharing happens from an information source, towards one or more recipients. TLP is a set of four standard labels (a fifth label is included in amber to limit the diffusion) used to indicate the sharing boundaries to be applied by the recipients. Only labels listed in this standard are considered valid by FIRST. This taxonomy includes additional labels for backward compatibility which are no more validated by FIRST SIG."@en .

misp:vulnerability a skos:ConceptScheme ;
    dcterms:title "A taxonomy for describing vulnerabilities (software, hardware, or social) on different scales or with additional available information."@en .

misp:acs-marking a skos:ConceptScheme ;
    dcterms:title "The Access Control Specification (ACS) marking type defines the object types required to implement automated access control systems based on the relevant policies governing sharing between participants."@en .

misp:aviation a skos:ConceptScheme ;
    dcterms:title "A taxonomy describing security threats or incidents against the aviation sector."@en .

misp:cti a skos:ConceptScheme ;
    dcterms:title "Cyber Threat Intelligence cycle to control workflow state of your process."@en .

misp:gsma-network-technology a skos:ConceptScheme ;
    dcterms:title "Taxonomy used by GSMA for their information sharing program with telco describing the types of infrastructure. WiP"@en .

misp:hunt-ex a skos:ConceptScheme ;
    dcterms:title "High-level, human-readable classification of a hunt's approach, provenance and outcome, designed for cross-organisation search and dashboards at ISAC / sector level. Detailed structured data lives in the threat-hunt-context, threat-hunt-hypothesis, threat-hunt-query and threat-hunt-finding objects; lifecycle uses workflow:state. Vocabulary is compatible with the PEAK framework (Splunk / Cisco Talos) and TaHiTI (NVB / FI-ISAC). Pair with existing taxonomies rather than duplicating them: use tlp and PAP for sharing, admiralty-scale and estimative-language for confidence and source reliability, cti-evaluation for CTI quality, priority-level for triage, DML for detection abstraction level, kill-chain / unified-kill-chain for phase, and the mitre-attack-pattern galaxy for technique mapping."@en .

misp:iep2-policy a skos:ConceptScheme ;
    dcterms:title "Forum of Incident Response and Security Teams (FIRST) Information Exchange Policy (IEP) v2.0 Policy"@en .

misp:monarc-threat a skos:ConceptScheme ;
    dcterms:title "MONARC Threats Taxonomy"@en .

misp:phishing a skos:ConceptScheme ;
    dcterms:title "Taxonomy to classify phishing attacks including techniques, collection mechanisms and analysis status."@en .

misp:CERT-XLM a skos:ConceptScheme ;
    dcterms:title "CERT-XLM Security Incident Classification."@en .

misp:access-method a skos:ConceptScheme ;
    dcterms:title "The access method used to remotely access a system."@en .

misp:ais-marking a skos:ConceptScheme ;
    dcterms:title "The AIS Marking Schema implementation is maintained by the National Cybersecurity and Communication Integration Center (NCCIC) of the U.S. Department of Homeland Security (DHS)"@en .

misp:cti-evaluation a skos:ConceptScheme ;
    dcterms:title "Evaluation taxonomy for cyber threat intelligence (CTI) quality and conversion quality in workflows such as MISP/STIX exchange and CTI Transmute, covering relevance, accuracy, timeliness, clarity, specificity, format validity, conversion fidelity, and usefulness."@en .

misp:diamond-model a skos:ConceptScheme ;
    dcterms:title "The Diamond Model for Intrusion Analysis establishes the basic atomic element of any intrusion activity, the event, composed of four core features: adversary, infrastructure, capability, and victim."@en .

misp:dni-ism a skos:ConceptScheme ;
    dcterms:title "A subset of Information Security Marking Metadata ISM as required by Executive Order (EO) 13526. As described by DNI.gov as Data Encoding Specifications for Information Security Marking Metadata in Controlled Vocabulary Enumeration Values for ISM"@en .

misp:ecsirt a skos:ConceptScheme ;
    dcterms:title "Incident Classification by the ecsirt.net version mkVI of 31 March 2015 enriched with IntelMQ taxonomy-type mapping."@en .

misp:estimative-language a skos:ConceptScheme ;
    dcterms:title "Estimative language to describe quality and credibility of underlying sources, data, and methodologies based Intelligence Community Directive 203 (ICD 203) and JP 2-0, Joint Intelligence"@en .

misp:eu-ai-act a skos:ConceptScheme ;
    dcterms:title "Taxonomy for the EU Artificial Intelligence Act (Regulation (EU) 2024/1689). Classifies AI systems by risk level, prohibited practices, high-risk use cases, and incident types for GRC and SOC reporting."@en .

misp:eu-nis-sector-and-subsectors a skos:ConceptScheme ;
    dcterms:title "Sectors, subsectors, and digital services as identified by the NIS Directive"@en .

misp:exercise a skos:ConceptScheme ;
    dcterms:title "Exercise is a taxonomy to describe if the information is part of one or more cyber or crisis exercise."@en .

misp:extended-event a skos:ConceptScheme ;
    dcterms:title "Reasons why an event has been extended. This taxonomy must be used on the extended event. The competitive analysis aspect is from Psychology of Intelligence Analysis by Richard J. Heuer, Jr. ref:http://www.foo.be/docs/intelligence/PsychofIntelNew.pdf"@en .

misp:pentest a skos:ConceptScheme ;
    dcterms:title "Penetration test (pentest) classification."@en .

misp:rsit a skos:ConceptScheme ;
    dcterms:title "Reference Security Incident Classification Taxonomy"@en .

misp:common-taxonomy a skos:ConceptScheme ;
    dcterms:title "Common Taxonomy for Law enforcement and CSIRTs"@en .

misp:content-classification a skos:ConceptScheme ;
    dcterms:title "Classification taxonomy for labeling the primary subject matter, intent, market context, and thematic domain of online content, including general information, technology, cybersecurity, cybercrime, markets, communities, finance, illegal markets, technical services, and geopolitical or hacktivist material."@en .

misp:europol-incident a skos:ConceptScheme ;
    dcterms:title "This taxonomy was designed to describe the type of incidents by class."@en .

misp:gea-nz-activities a skos:ConceptScheme ;
    dcterms:title "Information needed to track or monitor moments, periods or events that occur over time. This type of information is focused on occurrences that must be tracked for business reasons or represent a specific point in the evolution of ‘The Business’."@en .

misp:gsma-attack-category a skos:ConceptScheme ;
    dcterms:title "Taxonomy used by GSMA for their information sharing program with telco describing the attack categories"@en .

misp:iep a skos:ConceptScheme ;
    dcterms:title "Forum of Incident Response and Security Teams (FIRST) Information Exchange Policy (IEP) framework"@en .

misp:malware_classification a skos:ConceptScheme ;
    dcterms:title "Classification based on different categories. Based on https://www.sans.org/reading-room/whitepapers/incident/malware-101-viruses-32848"@en .

misp:misp a skos:ConceptScheme ;
    dcterms:title "MISP taxonomy to infer with MISP behavior or operation."@en .

misp:thales_group a skos:ConceptScheme ;
    dcterms:title "Thales Group Taxonomy - was designed with the aim of enabling desired sharing and preventing unwanted sharing between Thales Group security communities."@en .

misp:uas-additionnal-classification a skos:ConceptScheme ;
    dcterms:title "Additional UAV and UCAV-related tags for qualifying usage and model specifications."@en .

misp:DFRLab-dichotomies-of-disinformation a skos:ConceptScheme ;
    dcterms:title "DFRLab Dichotomies of Disinformation."@en .

misp:accessnow a skos:ConceptScheme ;
    dcterms:title "Access Now classification to classify an issue (such as security, human rights, youth rights)."@en .

misp:acn a skos:ConceptScheme ;
    dcterms:title "Cyber taxonomy for Italian National Cybersecurity Agency (ACN)"@en .

misp:agent-threat-rules a skos:ConceptScheme ;
    dcterms:title "Agent Threat Rules (ATR) is an open detection standard for AI agent threats published under the MIT licence. The taxonomy organises 713 community-maintained rules across ten attack categories covering prompt injection, tool poisoning, skill compromise, context exfiltration, agent manipulation, privilege escalation, excessive autonomy, model abuse, model security, and data poisoning. Predicates name the category; values are individual rule identifiers in the form ATR-YYYY-NNNNN."@en .

misp:cccs a skos:ConceptScheme ;
    dcterms:title "Internal taxonomy for CCCS."@en .

misp:enisa a skos:ConceptScheme ;
    dcterms:title "The present threat taxonomy is an initial version that has been developed on the basis of available ENISA material. This material has been used as an ENISA-internal structuring aid for information collection and threat consolidation purposes. It emerged in the time period 2012-2015."@en .

misp:ics a skos:ConceptScheme ;
    dcterms:title "FIRST.ORG CTI SIG - MISP Proposal for ICS/OT Threat Attribution (IOC) Project"@en .

misp:information-security-data-source a skos:ConceptScheme ;
    dcterms:title "Taxonomy to classify the information security data sources."@en .

misp:misinformation-website-label a skos:ConceptScheme ;
    dcterms:title "classification for the identification of type of misinformation among websites. Source:False, Misleading, Clickbait-y, and/or Satirical News Sources by Melissa Zimdars 2019"@en .

misp:pyoti a skos:ConceptScheme ;
    dcterms:title "PyOTI automated enrichment schemes for point in time classification of indicators."@en .

misp:doping-substances a skos:ConceptScheme ;
    dcterms:title "This taxonomy aims to list doping substances"@en .

misp:gea-nz-entities a skos:ConceptScheme ;
    dcterms:title "Information relating to instances of entities or things."@en .

misp:gea-nz-motivators a skos:ConceptScheme ;
    dcterms:title "Information relating to authority or governance."@en .

misp:ai-safety-benchmark a skos:ConceptScheme ;
    dcterms:title "AI safety benchmark v0.5, that has been created by the MLCommons AI Safety Working Group (WG)"@en .

misp:csirt-americas a skos:ConceptScheme ;
    dcterms:title "Taxonomía CSIRT Américas."@en .

misp:unified-kill-chain a skos:ConceptScheme ;
    dcterms:title "The Unified Kill Chain is a refinement to the Kill Chain."@en .

misp:veris a skos:ConceptScheme ;
    dcterms:title "Vocabulary for Event Recording and Incident Sharing (VERIS)"@en .

misp:action-taken a skos:Concept,
        skos:ConceptScheme ;
    dcterms:source "MISP Taxonomies (GitHub)"@fr ;
    dcterms:title "Action taken in the case of a security incident (CSIRT perspective)."@en ;
    skos:inScheme misp:action-taken ;
    skos:prefLabel "action-taken:=\"/\""@en .

misp:cnsd a skos:ConceptScheme ;
    dcterms:title "La presente taxonomia es la primera versión disponible para el Centro Nacional de Seguridad Digital del Perú."@en .

misp:kill-chain a skos:ConceptScheme ;
    dcterms:title "The Cyber Kill Chain, a phase-based model developed by Lockheed Martin, aims to help categorise and identify the stage of an attack."@en .

misp:use-case-applicability a skos:Concept,
        skos:ConceptScheme ;
    dcterms:source "MISP Taxonomies (GitHub)"@fr ;
    dcterms:title "The Use Case Applicability categories reflect standard resolution categories, to clearly display alerting rule configuration problems."@en ;
    skos:inScheme misp:use-case-applicability ;
    skos:prefLabel "use-case-applicability:=\"/\""@en .

misp:drugs a skos:Concept,
        skos:ConceptScheme ;
    dcterms:source "MISP Taxonomies (GitHub)"@fr ;
    dcterms:title "A taxonomy based on the superclass and class of drugs. Based on https://www.drugbank.ca/releases/latest"@en ;
    skos:inScheme misp:drugs ;
    skos:prefLabel "drugs:=\"/\""@en .

misp:europol-event a skos:ConceptScheme ;
