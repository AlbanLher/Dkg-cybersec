@prefix data: <http://dkg.cybersec.org/data#> .
@prefix dkg: <http://dkg.cybersec.org/tbox#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:ABox_Master a owl:Ontology ;
    rdfs:label "DKG ABox Master - Operational Cyber Security Graph"@fr .

data:TLP-CLEAR a dkg:TLPMarking ;
    rdfs:label "TLP:CLEAR"@en .

data:TLP-GREEN a dkg:TLPMarking ;
    rdfs:label "TLP:GREEN"@en .

data:Asset-Srv-Auth-02 a dkg:Asset ;
    rdfs:label "Serveur Authentification Central"@fr ;
    dkg:hasInstalledComponent data:Comp-Log4j-2-14 ;
    dkg:hasTLPMarking data:TLP-RED .

data:Asset-Srv-Prod-01 a dkg:Asset ;
    rdfs:label "Serveur Web Frontend Production"@fr ;
    dkg:hasInstalledComponent data:Comp-Apache-2-4-49 ;
    dkg:hasTLPMarking data:TLP-AMBER .

data:CAPEC-126 a dkg:ThreatPattern ;
    rdfs:label "Path Traversal"@en ;
    rdfs:comment "An attacker manipulates path references to access files outside the intended folder."@en .

data:CAPEC-63 a dkg:ThreatPattern ;
    rdfs:label "Simple Pass-Through"@en ;
    rdfs:comment "Attacker executes arbitrary code by passing commands through input fields."@en .

data:CVE-2021-41773 a dkg:Vulnerability ;
    rdfs:label "Apache HTTP Server Path Traversal Vulnerability"@en ;
    dkg:cvssScore "7.5"^^xsd:float ;
    dkg:hasWeakness data:CWE-22 ;
    dkg:isVulnerabilityOf data:Comp-Apache-2-4-49 .

data:CVE-2021-44228 a dkg:Vulnerability ;
    rdfs:label "Log4Shell Remote Code Execution"@en ;
    dkg:cvssScore "10.0"^^xsd:float ;
    dkg:hasWeakness data:CWE-78 ;
    dkg:isVulnerabilityOf data:Comp-Log4j-2-14 .

data:CWE-22 a dkg:Weakness ;
    rdfs:label "Improper Limitation of a Pathname to a Restricted Directory"@en ;
    dkg:hasThreatPattern data:CAPEC-126 .

data:CWE-78 a dkg:Weakness ;
    rdfs:label "Improper Neutralization of Special Elements used in an OS Command"@en ;
    dkg:hasThreatPattern data:CAPEC-63 .

data:TLP-AMBER a dkg:TLPMarking ;
    rdfs:label "TLP:AMBER"@en .

data:TLP-RED a dkg:TLPMarking ;
    rdfs:label "TLP:RED"@en .

data:Comp-Apache-2-4-49 a dkg:SoftwareComponent ;
    rdfs:label "Apache HTTP Server v2.4.49"@fr ;
    dkg:hasVulnerability data:CVE-2021-41773 ;
    dkg:isComponentOf data:Asset-Srv-Prod-01 .

data:Comp-Log4j-2-14 a dkg:SoftwareComponent ;
    rdfs:label "Apache Log4j Core v2.14.1"@fr ;
    dkg:hasVulnerability data:CVE-2021-44228 ;
    dkg:isComponentOf data:Asset-Srv-Auth-02 .

