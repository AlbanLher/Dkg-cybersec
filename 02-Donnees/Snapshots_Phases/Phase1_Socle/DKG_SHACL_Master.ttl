@prefix dkg: <http://dkg.cybersec.org/tbox#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dkg:AssetShape a sh:NodeShape ;
    sh:targetClass dkg:Asset .

dkg:SoftwareComponentShape a sh:NodeShape ;
    sh:targetClass dkg:SoftwareComponent .

dkg:VulnerabilityShape a sh:NodeShape ;
    sh:property dkg:CvssScorePropertyShape ;
    sh:targetClass dkg:Vulnerability .

dkg:CvssScorePropertyShape a sh:PropertyShape ;
    sh:datatype xsd:float ;
    sh:maxInclusive "10.0"^^xsd:float ;
    sh:path dkg:cvssScore .

