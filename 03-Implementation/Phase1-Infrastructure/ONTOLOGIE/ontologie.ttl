@prefix : <http://example.org/cyber-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# === Classes de Phase 0 (héritées) ===
:Device a owl:Class ;
    rdfs:label "Appareil" ;
    rdfs:comment "Un device physique ou virtuel." .

:Software a owl:Class ;
    rdfs:label "Logiciel" .

:Vulnerability a owl:Class ;
    rdfs:label "Vulnérabilité" ;
    rdfs:subClassOf :Threat .

:Threat a owl:Class ;
    rdfs:label "Menace" .

:Rule a owl:Class ;
    rdfs:label "Règle de sécurité" .

:Action a owl:Class ;
    rdfs:label "Action corrective" .

# === NOUVELLES Classes de Phase 1 ===
:InternalDevice a owl:Class ;
    rdfs:subClassOf :Device ;  # <-- Hiérarchie
    rdfs:label "Device interne" ;
    rdfs:comment "Device appartenant à l'entreprise (ex: serveur, PC des employés)." .

:ExternalDevice a owl:Class ;
    rdfs:subClassOf :Device ;
    rdfs:label "Device externe" ;
    rdfs:comment "Device hors du réseau de l'entreprise (ex: client, partenaire)." .

:ComplianceRule a owl:Class ;
    rdfs:subClassOf :Rule ;
    rdfs:label "Règle de conformité" ;
    rdfs:comment "Règle liée à une exigence réglementaire (ex: RGPD, NIS2)." .

:ComplianceStatus a owl:Class ;
    rdfs:label "Statut de conformité" .

:Compliant a owl:NamedIndividual , :ComplianceStatus ;
    rdfs:label "Conforme" .

:NonCompliant a owl:NamedIndividual , :ComplianceStatus ;
    rdfs:label "Non conforme" .

# === NOUVELLES Propriétés de Phase 1 ===
:hasComplianceStatus a owl:ObjectProperty ;
    rdfs:domain :InternalDevice ;
    rdfs:range :ComplianceStatus ;
    rdfs:label "a pour statut de conformité" .

:appliesTo a owl:ObjectProperty ;
    rdfs:domain :ComplianceRule ;
    rdfs:range :InternalDevice ;
    rdfs:label "s'applique à" .

# === Propriétés existantes (Phase 0) ===
:hasSoftware a owl:ObjectProperty ;
    rdfs:domain :Device ;
    rdfs:range :Software ;
    rdfs:label "a pour logiciel" .

:hasVulnerability a owl:ObjectProperty ;
    rdfs:domain :Device ;
    rdfs:range :Vulnerability ;
    rdfs:label "a pour vulnérabilité" .

:requiresAction a owl:ObjectProperty ;
    rdfs:domain :Vulnerability ;
    rdfs:range :Action ;
    rdfs:label "nécessite l'action" .

:cvssScore a owl:DatatypeProperty ;
    rdfs:domain :Vulnerability ;
    rdfs:range xsd:float ;
    rdfs:label "score CVSS" .
