@prefix : <http://example.org/cyber-ontology#> .
@prefix pseudo: <http://example.org/pseudo-private-ontology#> .

pseudo\:UpdateOpenSSL a \:Action ;
    foaf\:name "Mettre à jour OpenSSL" ;
    \:description "Règle fictive : Mettre à jour OpenSSL vers 3.0.8." .

pseudo\:HighCVSS_Rule a \:Rule ;
    foaf\:name "Règle CVSS Élevé" ;
    \:description "Si CVSS > 7, appliquer une action corrective." ;
    \:appliesTo \:Device ;
    \:requiresAction pseudo\:UpdateOpenSSL .
