@prefix dkg: <http://dkg.cybersec.org/tbox#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rbox: <http://dkg.cybersec.org/rbox#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rbox: a owl:Ontology ;
    rdfs:label "RBox Public Reference Graph - DKG Cybersec"@en ;
    rdfs:comment "Généré automatiquement le Thu Aug 27 22:22:57 2026 à partir du feed NVD & MITRE CWE Mock Feed"@fr ;
    owl:imports dkg: .

rbox:CVE-2021-23017 a dkg:Vulnerability ;
    rdfs:label "1-byte memory overwrite in NGINX resolver"@en ;
    dkg:classifiedUnder rbox:CWE-193 ;
    dkg:cvssScore "7.5"^^xsd:float ;
    dkg:cvssVector "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H"^^xsd:string .

rbox:CWE-193 a dkg:Weakness ;
    rdfs:label "Off-by-one Error"@en ;
    rdfs:comment "Erreur d'un élément dans le calcul de la taille d'une boucle ou d'un tampon de mémoire."@fr .

