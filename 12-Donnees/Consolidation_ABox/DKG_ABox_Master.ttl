@prefix dkg: <http://dkg.cybersec.org/tbox#> .
@prefix dkg-inst: <http://dkg.cybersec.org/abox#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dkg: a owl:Ontology ;
    rdfs:label "Ontologie DKG Cybersec - Socle Structurel"@fr ;
    rdfs:comment "TBox & RBox Stricte : définitions des classes, propriétés et relations."@fr .

dkg:componentName a owl:DatatypeProperty ;
    rdfs:label "componentName"@en ;
    rdfs:comment "Nom du produit logiciel."@fr ;
    rdfs:domain dkg:SoftwareComponent ;
    rdfs:range xsd:string .

dkg:cveId a owl:DatatypeProperty ;
    rdfs:label "cveId"@en ;
    rdfs:comment "Identifiant canonique CVE."@fr ;
    rdfs:domain dkg:Vulnerability ;
    rdfs:range xsd:string .

dkg:cvssScore a owl:DatatypeProperty ;
    rdfs:label "cvssScore"@en ;
    rdfs:comment "Score CVSS v3/v4 de gravité."@fr ;
    rdfs:domain dkg:Vulnerability ;
    rdfs:range xsd:float .

dkg:hasVulnerability a owl:ObjectProperty ;
    rdfs:label "hasVulnerability"@en ;
    rdfs:domain dkg:SoftwareComponent ;
    rdfs:range dkg:Vulnerability .

dkg:hasWeakness a owl:ObjectProperty ;
    rdfs:label "hasWeakness"@en ;
    rdfs:domain dkg:Vulnerability ;
    rdfs:range dkg:Weakness .

dkg:hostname a owl:DatatypeProperty ;
    rdfs:label "hostname"@en ;
    rdfs:comment "Nom d'hôte de l'équipement."@fr ;
    rdfs:domain dkg:Asset ;
    rdfs:range xsd:string .

dkg:ipAddress a owl:DatatypeProperty ;
    rdfs:label "ipAddress"@en ;
    rdfs:comment "Adresse IP principale."@fr ;
    rdfs:domain dkg:Asset ;
    rdfs:range xsd:string .

dkg:isComponentOf a owl:ObjectProperty ;
    rdfs:label "isComponentOf"@en ;
    rdfs:domain dkg:SoftwareComponent ;
    rdfs:range dkg:Asset ;
    owl:inverseOf dkg:hasInstalledComponent .

dkg:version a owl:DatatypeProperty ;
    rdfs:label "version"@en ;
    rdfs:comment "Version spécifique du composant."@fr ;
    rdfs:domain dkg:SoftwareComponent ;
    rdfs:range xsd:string .

dkg-inst:CAPEC-112 a dkg:ThreatPattern ;
    rdfs:label "CAPEC-112: Command Injection"@en ;
    dkg:hasTLPMarking dkg-inst:TLP-CLEAR ;
    dkg:lastEnrichedAt "2026-08-28T19:30:03.710376+00:00"^^xsd:dateTime ;
    dkg:patternDescription "An attacker leverages uncontrolled deserialization to inject arbitrary system commands."^^xsd:string .

dkg-inst:CAPEC-14 a dkg:ThreatPattern ;
    rdfs:label "CAPEC-14: Far Side Off-by-One Buffer Overflow"@en ;
    dkg:hasTLPMarking dkg-inst:TLP-CLEAR ;
    dkg:lastEnrichedAt "2026-08-28T19:30:03.710376+00:00"^^xsd:dateTime ;
    dkg:patternDescription "An attacker forces an off-by-one calculation error leading to adjacent memory corruption."^^xsd:string .

dkg-inst:CVE-2021-23017 a dkg:Vulnerability ;
    dkg:cveDescription "A 1-byte memory write overflow in Nginx resolver allows a remote attacker to cause denial of service or execution of arbitrary code."^^xsd:string ;
    dkg:cveId "CVE-2021-23017"^^xsd:string ;
    dkg:cvssScore "7.5"^^xsd:float ;
    dkg:cvssV3Vector "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H"^^xsd:string ;
    dkg:hasTLPMarking dkg-inst:TLP-CLEAR ;
    dkg:hasWeakness dkg-inst:CWE-193 ;
    dkg:lastEnrichedAt "2026-08-28T19:30:03.710376+00:00"^^xsd:dateTime ;
    dkg:severityLabel "HIGH"^^xsd:string .

dkg-inst:CVE-2021-44228 a dkg:Vulnerability ;
    dkg:cveDescription "Apache Log4j2 JNDI features used in configuration, log messages, and parameters do not protect against attacker controlled LDAP and other JNDI related endpoints."^^xsd:string ;
    dkg:cveId "CVE-2021-44228"^^xsd:string ;
    dkg:cvssScore "10.0"^^xsd:float ;
    dkg:cvssV3Vector "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H"^^xsd:string ;
    dkg:hasTLPMarking dkg-inst:TLP-CLEAR ;
    dkg:hasWeakness dkg-inst:CWE-502 ;
    dkg:lastEnrichedAt "2026-08-28T19:30:03.710376+00:00"^^xsd:dateTime ;
    dkg:severityLabel "CRITICAL"^^xsd:string .

dkg-inst:CWE-193 a dkg:Weakness ;
    rdfs:label "CWE-193: Off-by-one Error"@en ;
    dkg:hasTLPMarking dkg-inst:TLP-CLEAR ;
    dkg:hasThreatPattern dkg-inst:CAPEC-14 .

dkg-inst:CWE-502 a dkg:Weakness ;
    rdfs:label "CWE-502: Deserialization of Untrusted Data"@en ;
    dkg:hasTLPMarking dkg-inst:TLP-CLEAR ;
    dkg:hasThreatPattern dkg-inst:CAPEC-112 .

dkg-inst:log4j-core-2.14.1 a dkg:SoftwareComponent ;
    dkg:componentName "log4j-core"^^xsd:string ;
    dkg:hasTLPMarking dkg-inst:TLP-AMBER ;
    dkg:hasVulnerability dkg-inst:CVE-2021-44228 ;
    dkg:isComponentOf dkg-inst:srv-web-01 ;
    dkg:version "2.14.1"^^xsd:string .

dkg-inst:nginx-1.18.0 a dkg:SoftwareComponent ;
    dkg:componentName "nginx"^^xsd:string ;
    dkg:hasTLPMarking dkg-inst:TLP-AMBER ;
    dkg:hasVulnerability dkg-inst:CVE-2021-23017 ;
    dkg:isComponentOf dkg-inst:srv-web-01 ;
    dkg:version "1.18.0"^^xsd:string .

dkg-inst:postgresql-13.2 a dkg:SoftwareComponent ;
    dkg:componentName "postgresql"^^xsd:string ;
    dkg:hasTLPMarking dkg-inst:TLP-AMBER ;
    dkg:isComponentOf dkg-inst:srv-db-01 ;
    dkg:version "13.2"^^xsd:string .

dkg-inst:srv-db-01 a dkg:Asset ;
    dkg:hasInstalledComponent dkg-inst:postgresql-13.2 ;
    dkg:hasTLPMarking dkg-inst:TLP-AMBER ;
    dkg:hostname "srv-db-01.corp.internal"^^xsd:string ;
    dkg:ipAddress "192.168.1.51"^^xsd:string .

dkg:hasInstalledComponent a owl:ObjectProperty ;
    rdfs:label "hasInstalledComponent"@en ;
    rdfs:comment "Rattache un composant logiciel à un équipement."@fr ;
    rdfs:domain dkg:Asset ;
    rdfs:range dkg:SoftwareComponent .

dkg-inst:srv-web-01 a dkg:Asset ;
    dkg:hasInstalledComponent dkg-inst:log4j-core-2.14.1,
        dkg-inst:nginx-1.18.0 ;
    dkg:hasTLPMarking dkg-inst:TLP-AMBER ;
    dkg:hostname "srv-web-01.corp.internal"^^xsd:string ;
    dkg:ipAddress "192.168.1.50"^^xsd:string .

dkg:ThreatPattern a owl:Class ;
    rdfs:label "ThreatPattern"@en ;
    rdfs:comment "Modèle d'attaque ou pattern d'exploitation (ex: CAPEC)."@fr .

dkg:Weakness a owl:Class ;
    rdfs:label "Weakness"@en ;
    rdfs:comment "Type de faiblesse logicielle sous-jacente (ex: CWE)."@fr .

dkg-inst:TLP-AMBER a dkg:TLPMarking ;
    dkg:tlpColor "AMBER"^^xsd:string .

dkg-inst:TLP-CLEAR a dkg:TLPMarking ;
    dkg:tlpColor "CLEAR"^^xsd:string .

dkg:Asset a owl:Class ;
    rdfs:label "Asset"@en ;
    rdfs:comment "Équipement ou ressource de l'infrastructure informatique (ex: serveur, VM)."@fr .

dkg:Vulnerability a owl:Class ;
    rdfs:label "Vulnerability"@en ;
    rdfs:comment "Vulnérabilité ou faille de sécurité identifiée (ex: CVE)."@fr .

dkg:SoftwareComponent a owl:Class ;
    rdfs:label "SoftwareComponent"@en ;
    rdfs:comment "Composant logiciel ou brique applicative installée sur un Asset (ex: NGINX, OpenSSL)."@fr .

