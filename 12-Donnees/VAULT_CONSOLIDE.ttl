@prefix : <http://example.org/cyber-ontology#> .
@prefix cve: <https://cve.mitre.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/dkg/lexique#Vulnerability> a skos:Concept ;
    skos:exactMatch :Vulnerability ;
    skos:prefLabel "Vulnérabilité"@fr .

cve:CVE-2023-1234 a :Vulnerability ;
    :cvssScore 9.8 ;
    :description "Vulnérabilité critique dans OpenSSL 1.0.2 permettant une exécution de code à distance." ;
    foaf:name "CVE-2023-1234" .

:Vulnerability a owl:Class ;
    rdf:label "Vulnerability"@en .

