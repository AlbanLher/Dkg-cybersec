@prefix ex-l: <http://example.org/dkg/lexique#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex-o: <http://example.org/cyber-ontology#> .

ex-l:Scheme_Projet a skos:ConceptScheme ;
    skos:prefLabel "Lexique Projet DKG"@fr .

ex-l:Concept_Ontologie a skos:Concept ;
    skos:inScheme ex-l:Scheme_Projet ;
    skos:prefLabel "Ontologie"@fr ;
    skos:definition "Structure formelle des classes, propriétés et relations du domaine, définie en OWL."@fr ;
    skos:exactMatch ex-o:Ontology .

ex-l:Concept_TBox a skos:Concept ;
    skos:inScheme ex-l:Scheme_Projet ;
    skos:prefLabel "TBox (Terminological Box)"@fr ;
    skos:definition "Boîte terminologique contenant le lexique (SKOS) et l'ontologie (OWL) du DKG."@fr .

ex-l:Concept_ABox a skos:Concept ;
    skos:inScheme ex-l:Scheme_Projet ;
    skos:prefLabel "ABox (Assertion Box)"@fr ;
    skos:definition "Boîte d'assertions contenant les instances concrètes (données) du DKG."@fr .

ex-l:Concept_Lexique a skos:Concept ;
    skos:inScheme ex-l:Scheme_Projet ;
    skos:prefLabel "Lexique"@fr ;
    skos:definition "Vocabulaire contrôlé des concepts métiers, structuré en SKOS."@fr .

ex-l:Concept_DKG a skos:Concept ;
    skos:inScheme ex-l:Scheme_Projet ;
    skos:prefLabel "Dynamic Knowledge Graph (DKG)"@fr ;
    skos:definition "Graphe de connaissances dynamique capable d'évoluer avec de nouvelles données et concepts."@fr .
