@prefix cyber: <http://example.org/cyber-ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cyber:PC_Alban_POC a cyber:Device ;
    cyber:hasIP "192.168.1.100" ;
    cyber:hasSoftware cyber:Apache_2_4_57,
        cyber:OpenSSL_1_0_2 ;
    foaf:name "PC-Alban-POC" .

cyber:Router_POC a cyber:Device ;
    cyber:hasIP "192.168.1.1" ;
    cyber:hasSoftware cyber:Firmware_1_0 ;
    foaf:name "Router-POC" .

cyber:cvssScore a owl:DatatypeProperty ;
    rdfs:label "score CVSS"@fr ;
    rdfs:domain cyber:Vulnerability ;
    rdfs:range xsd:float .

cyber:hasIP a owl:DatatypeProperty ;
    rdfs:label "a pour IP"@fr ;
    rdfs:domain cyber:Device ;
    rdfs:range xsd:string .

cyber:hasSoftware a owl:ObjectProperty ;
    rdfs:label "a pour logiciel"@fr ;
    rdfs:domain cyber:Device ;
    rdfs:range cyber:Software .

cyber:hasVulnerability a owl:ObjectProperty ;
    rdfs:label "a pour vulnérabilité"@fr ;
    rdfs:domain cyber:Device ;
    rdfs:range cyber:Vulnerability .

cyber:version a owl:DatatypeProperty ;
    rdfs:label "version"@fr ;
    rdfs:domain cyber:Software ;
    rdfs:range xsd:string .

cyber:Apache_2_4_57 a cyber:Software ;
    cyber:version "2.4.57" ;
    foaf:name "Apache" .

cyber:Firmware_1_0 a cyber:Software ;
    cyber:version "1.0" ;
    foaf:name "Firmware" .

cyber:OpenSSL_1_0_2 a cyber:Software ;
    cyber:version "1.0.2" ;
    foaf:name "OpenSSL" .

cyber:Vulnerability a owl:Class ;
    rdfs:label "Vulnérabilité"@fr .

cyber:Device a owl:Class ;
    rdfs:label "Équipement"@fr .

cyber:Software a owl:Class ;
    rdfs:label "Logiciel"@fr .

