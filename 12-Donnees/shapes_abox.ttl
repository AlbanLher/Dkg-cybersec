@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dkg: <http://dkg.cybersec.org/tbox#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Règle 1 : Tout Asset DOIT avoir au moins 1 composant installé
dkg:AssetShape
    a sh:NodeShape ;
    sh:targetClass dkg:Asset ;
    sh:property [
        sh:path dkg:hasInstalledComponent ;
        sh:minCount 1 ;
        sh:message "ERREUR SHACL : L'équipement (Asset) n'a aucun composant rattaché (hasInstalledComponent) !" ;
    ] .

# Règle 2 : Tout Composant DOIT être rattaché à au moins 1 CVE
dkg:ComponentShape
    a sh:NodeShape ;
    sh:targetClass dkg:SoftwareComponent ;
    sh:property [
        sh:path dkg:hasVulnerability ;
        sh:minCount 1 ;
        sh:message "ERREUR SHACL : Le composant n'est rattaché à aucune vulnérabilité (hasVulnerability) !" ;
    ] .
